GIT_PINS = [
    "-c", "core.quotepath=off",
    "-c", "diff.noprefix=false",
    "-c", "diff.mnemonicPrefix=false",
    "-c", "diff.relative=false",
    "-c", "diff.interHunkContext=0",
    "-c", "diff.suppressBlankEmpty=false",
    "-c", "diff.ignoreSubmodules=none",
    "-c", "diff.orderFile=" + os.devnull,
    "-c", "color.ui=never",
    "-c", "color.diff=never",
    "-c", "core.attributesFile=" + os.devnull,
    "-c", "log.showSignature=false",
    "-c", "core.fsmonitor=false",
]
DIFF_FLAGS = [
    "--no-ext-diff", "--no-textconv", "--no-color", "--no-relative",
    "--diff-algorithm=myers", "--indent-heuristic", "--ignore-submodules=none",
    "--src-prefix=a/", "--dst-prefix=b/",
]
GIT_ENV_DROP = ("GIT_EXTERNAL_DIFF", "GIT_DIFF_OPTS", "GIT_DIFF_PATH_COUNTER", "GIT_DIFF_PATH_TOTAL")


def git_env():
    env = dict(os.environ)
    for key in GIT_ENV_DROP:
        env.pop(key, None)
    env["GIT_TERMINAL_PROMPT"] = "0"
    env["GIT_LITERAL_PATHSPECS"] = "1"
    env["GIT_NO_REPLACE_OBJECTS"] = "1"
    env["LC_ALL"] = "C"
    return env


def git(args, check=True, quiet=False):
    """Run git with pinned settings. Returns stdout as bytes."""
    try:
        proc = subprocess.run(["git"] + GIT_PINS + args, capture_output=True, env=git_env())
    except FileNotFoundError:
        die("git not found")
    if check and proc.returncode != 0:
        if quiet:
            return None
        err = proc.stderr.decode("utf-8", "replace").strip()
        die("`git %s` failed:\n%s" % (" ".join(args[:2]), err))
    if proc.returncode != 0:
        return None
    return proc.stdout


def text(data):
    """Decode git output. Undecodable bytes become lone surrogates, which the hidden-text
    check reports and `clean` escapes, so nothing is silently dropped."""
    return data.decode("utf-8", "surrogateescape")


def git_version():
    out = text(git(["--version"])).strip()
    match = re.search(r"(\d+)\.(\d+)", out)
    return (int(match.group(1)), int(match.group(2))) if match else (0, 0)


def rev(ref):
    out = git(["rev-parse", "--verify", "--quiet", ref + "^{commit}"], check=False)
    return text(out).strip() if out else None


def is_shallow():
    out = git(["rev-parse", "--is-shallow-repository"], check=False)
    return bool(out) and text(out).strip() == "true"


def git_dir():
    out = git(["rev-parse", "--absolute-git-dir"], check=False)
    return text(out).strip() if out else None


def read_blob(sha):
    return git(["cat-file", "blob", sha])


class BlobReader(object):
    """Read many blobs through one `git cat-file --batch` process."""

    def __init__(self):
        self.proc = subprocess.Popen(["git"] + GIT_PINS + ["cat-file", "--batch"], stdin=subprocess.PIPE,
                                     stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env=git_env())
        self.cache = {}

    def read(self, sha):
        if sha in self.cache:
            return self.cache[sha]
        self.proc.stdin.write(sha.encode("ascii") + b"\n")
        self.proc.stdin.flush()
        header = self.proc.stdout.readline().split()
        if len(header) != 3 or header[1] != b"blob":
            die("cannot read blob %s" % sha)
        size = int(header[2])
        data = self.proc.stdout.read(size)
        self.proc.stdout.read(1)
        self.cache[sha] = data
        return data

    def close(self):
        try:
            self.proc.stdin.close()
            self.proc.wait(timeout=10)
        except Exception:
            self.proc.kill()


def read_path(commit, path):
    """File content at a commit, or None if the path is not a file there."""
    spec = "%s:%s" % (commit, path)
    kind = git(["cat-file", "-t", spec], check=False)
    if not kind or text(kind).strip() != "blob":
        return None
    return git(["cat-file", "blob", spec])


def list_tree(commit):
    out = git(["ls-tree", "-r", "-z", "--full-tree", "--name-only", commit])
    return [p for p in text(out).split("\0") if p]


def merge_base_local(a, b):
    out = git(["merge-base", a, b], check=False)
    return text(out).strip() if out else None


# ---------------------------------------------------------------------------
# text safety
#
# Allowed: letters, digits, punctuation and symbols (except the blank ones below), the
# ordinary space and no-break space, newline and tab, up to MAX_MARKS combining marks on a
# visible character, one emoji variation selector right after a visible character, and the
# three subdivision flag emoji. Everything else is reported, including control, format,
# private-use, unassigned and surrogate code points, other spaces and zero-width characters.
ALLOWED_SPACES = set([0x20, 0xA0])
BLANK_CHARS = set([0x115F, 0x1160, 0x2800, 0x3164, 0xFFA0])
INVISIBLE_MARKS = set([0x034F, 0x17B4, 0x17B5, 0x180B, 0x180C, 0x180D, 0x180F])
EMOJI_SELECTORS = set([0xFE0E, 0xFE0F])
VARIATION_SELECTORS = set(range(0xFE00, 0xFE10)) | set(range(0xE0100, 0xE01F0))
MAX_MARKS = 3
TAG_FLAG_BASE = 0x1F3F4
FLAG_TAGS = [
    "".join(chr(0xE0000 + ord(c)) for c in name) + chr(0xE007F) for name in ("gbeng", "gbsct", "gbwls")
]
ZWJ = 0x200D


def hidden_positions(s, allow_emoji_zwj=False):
    """Indexes of characters in s that are not on the allowlist."""
    bad, i, prev, marks = [], 0, None, 0
    while i < len(s):
        ch = s[i]
        cp = ord(ch)
        category = unicodedata.category(ch)
        if ch in "\n\t" or cp in ALLOWED_SPACES:
            prev, marks = None, 0
            i += 1
            continue
        if cp == TAG_FLAG_BASE:
            tail = next((t for t in FLAG_TAGS if s.startswith(t, i + 1)), "")
            prev, marks = "base", 0
            i += 1 + len(tail)
            continue
        if (
            allow_emoji_zwj and cp == ZWJ and i > 0 and i + 1 < len(s)
            and unicodedata.category(s[i - 1]) in ("So", "Mn") and unicodedata.category(s[i + 1]) == "So"
        ):
            kind = "selector"
        elif category[0] in "LNPS" and cp not in BLANK_CHARS:
            kind = "base"
        elif cp in EMOJI_SELECTORS and prev == "base":
            kind = "selector"
        elif (
            category[0] == "M"
            and cp not in INVISIBLE_MARKS
            and cp not in VARIATION_SELECTORS
            and prev in ("base", "selector", "mark")
            and marks < MAX_MARKS
        ):
            kind = "mark"
        else:
            kind = None
            bad.append(i)
        marks = marks + 1 if kind == "mark" else 0
        prev = kind
        i += 1
    return bad


def unsafe_chars(s):
    return [s[i] for i in hidden_positions(s)]


def escape_char(ch):
    return "\\u%04x" % ord(ch) if ord(ch) <= 0xFFFF else "\\U%08x" % ord(ch)


def clean(s):
    """Make third-party text safe to print: escape every character outside the allowlist."""
    s = (s or "").replace("\r\n", "\n")
    bad = set(hidden_positions(s))
    return "".join(escape_char(ch) if i in bad else ch for i, ch in enumerate(s))


def clean_line(s):
    return clean(s).replace("\n", "\\n").replace("\t", "\\t")


def char_codes(chars):
    return ", ".join(sorted(set("U+%04X" % ord(ch) for ch in chars)))


def safe_name(*parts):
    return re.sub(r"[^A-Za-z0-9._-]+", "_", "-".join(str(p) for p in parts).lower())


# ---------------------------------------------------------------------------
# diff model
#
# A PR is diffed from its merge base to its head, which is what GitHub shows. The file
# list comes from `git diff --raw -z`; each changed text file is then diffed blob to blob,
# so no path is ever parsed out of a patch header.

NULL_SHA_RE = re.compile(r"^0+$")
HUNK_RE = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@")
MODE_FILE = ("100644", "100755")
MODE_LINK = "120000"
MODE_SUBMODULE = "160000"


def raw_changes(base, head):
    """Changed files between two commits, renames detected, sorted by path."""
    out = git(
        ["diff", "--raw", "-z", "--no-abbrev", "-M50%", "-l100000"] + DIFF_FLAGS + [base, head]
    )
    fields = text(out).split("\0")
    changes, i = [], 0
    while i < len(fields):
        meta = fields[i]
        if not meta:
            i += 1
            continue
        if not meta.startswith(":"):
            die("unexpected git diff --raw output")
        parts = meta[1:].split(" ")
        old_mode, new_mode, old_blob, new_blob, status = parts[0], parts[1], parts[2], parts[3], parts[4]
        letter = status[0]
        if letter in "RC":
            old_path, new_path = fields[i + 1], fields[i + 2]
            i += 3
        else:
            old_path = new_path = fields[i + 1]
            i += 2
        changes.append({
            "status": letter,
            "similarity": int(status[1:]) if len(status) > 1 and status[1:].isdigit() else None,
            "old_path": None if letter == "A" else old_path,
            "path": None if letter == "D" else new_path,
            "old_mode": None if NULL_SHA_RE.match(old_mode) else old_mode,
            "new_mode": None if NULL_SHA_RE.match(new_mode) else new_mode,
            "old_blob": None if NULL_SHA_RE.match(old_blob) else old_blob,
            "new_blob": None if NULL_SHA_RE.match(new_blob) else new_blob,
        })
    changes.sort(key=lambda c: (c["path"] or c["old_path"]))
    return changes


def looks_binary(data):
    """git's own heuristic: a NUL byte in the first 8000 bytes."""
    return b"\0" in data[:8000]


def blob_kind(mode):
    if mode == MODE_SUBMODULE:
        return "submodule"
    if mode == MODE_LINK:
        return "symlink"
    if mode in MODE_FILE:
        return "file"
    return None


def split_lines(data):
    lines = text(data).split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    return [l[:-1] if l.endswith("\r") else l for l in lines]


def parse_hunks(patch):
    """Hunks from a unified diff: each a list of (kind, old_no, new_no, text)."""
    hunks, current, old_no, new_no = [], None, 0, 0
    for raw in text(patch).split("\n"):
        match = HUNK_RE.match(raw)
        if match:
            current = []
            hunks.append(current)
            old_no, new_no = int(match.group(1)), int(match.group(3))
            continue
        if current is None or not raw or raw.startswith("\\"):
            continue
        line = raw[1:]
        if line.endswith("\r"):
            line = line[:-1]
        if raw[0] == "+":
            current.append(("+", None, new_no, line))
            new_no += 1
        elif raw[0] == "-":
            current.append(("-", old_no, None, line))
            old_no += 1
        elif raw[0] == " ":
            current.append((" ", old_no, new_no, line))
            old_no += 1
            new_no += 1
    return [h for h in hunks if h]


def file_hunks(change, old_data, new_data):
    """Text hunks for one file change (empty for binaries, submodules, mode-only changes)."""
    if old_data is None and new_data is None:
        return []
    if old_data is None:
        return [[("+", None, n, l) for n, l in enumerate(split_lines(new_data), 1)]] if new_data else []
    if new_data is None:
        return [[("-", n, None, l) for n, l in enumerate(split_lines(old_data), 1)]] if old_data else []
    if change["old_blob"] == change["new_blob"]:
        return []
    patch = git(["diff", "-a", "-U3"] + DIFF_FLAGS + [change["old_blob"], change["new_blob"]])
    return parse_hunks(patch)


def line_range(lines, side):
    nums = [l[1] if side == "base" else l[2] for l in lines]
    nums = [n for n in nums if n is not None]
    return [min(nums), max(nums)] if nums else None


def make_units(index, hunks, splittable=True):
    """Coverage units for one file: F.0 always, then F.H per hunk, F.H.C per chunk."""
    units = [{"id": "%d.0" % index, "file": index, "kind": "file", "lines": [],
              "head": None, "base": None, "added": 0, "removed": 0}]
    for h, lines in enumerate(hunks, 1):
        if splittable and len(lines) > CHUNK_LINES:
            pieces = [lines[i:i + CHUNK_LINES] for i in range(0, len(lines), CHUNK_LINES)]
            ids = ["%d.%d.%d" % (index, h, c) for c in range(1, len(pieces) + 1)]
        else:
            pieces, ids = [lines], ["%d.%d" % (index, h)]
        for uid, piece in zip(ids, pieces):
            units.append({
                "id": uid, "file": index, "kind": "hunk", "lines": piece,
                "head": line_range(piece, "head"), "base": line_range(piece, "base"),
                "added": sum(1 for l in piece if l[0] == "+"),
                "removed": sum(1 for l in piece if l[0] == "-"),
            })
    return units


# ---------------------------------------------------------------------------
# paths, globs and policy

def glob_regex(pattern):
    """Translate a glob to a regex. `**/` matches any directories, `*` stays in one segment.
    Patterns are anchored at the repository root."""
    out, i = [], 0
    while i < len(pattern):
        if pattern.startswith("**/", i):
            out.append("(?:.*/)?")
            i += 3
        elif pattern.startswith("/**", i) and i + 3 == len(pattern):
            out.append("/.*")
            i += 3
        elif pattern.startswith("**", i):
            out.append(".*")
            i += 2
        elif pattern[i] == "*":
            out.append("[^/]*")
            i += 1
        elif pattern[i] == "?":
            out.append("[^/]")
            i += 1
        elif pattern[i] == "[":
            end = pattern.find("]", i + 1)
            if end == -1:
                out.append(re.escape("["))
                i += 1
            else:
                body = pattern[i + 1:end]
                if body.startswith("!"):
                    body = "^" + body[1:]
                out.append("[" + body.replace("\\", "\\\\") + "]")
                i = end + 1
        else:
            out.append(re.escape(pattern[i]))
            i += 1
    try:
        return re.compile("^" + "".join(out) + "$")
    except re.error:
        return re.compile("^" + re.escape(pattern) + "$")


_GLOB_CACHE = {}


def glob_match(pattern, path):
    rx = _GLOB_CACHE.get(pattern)
    if rx is None:
        rx = _GLOB_CACHE[pattern] = glob_regex(pattern)
    return bool(rx.match(path))


def any_glob(patterns, path):
    return bool(path) and any(glob_match(p, path) for p in patterns)


def gitattributes_pattern(directory, pattern):
    """A .gitattributes pattern as a root-anchored glob."""
    anchored = "/" in pattern.rstrip("/")
    pattern = pattern.lstrip("/")
    prefix = (directory + "/") if directory else ""
    return prefix + (pattern if anchored else "**/" + pattern)


def load_generated_attributes(commit, tree):
    """(glob, value) pairs for linguist-generated, in the order git applies them."""
    files = sorted((p for p in tree if p == ".gitattributes" or p.endswith("/.gitattributes")),
                   key=lambda p: (p.count("/"), p))
    rules = []
    for path in files:
        data = read_path(commit, path)
        if data is None:
            continue
        directory = os.path.dirname(path)
        for line in text(data).splitlines():
            line = line.strip()
            if not line or line.startswith("#") or line.startswith("[attr]"):
                continue
            parts = line.split()
            pattern, attrs = parts[0], parts[1:]
            for attr in attrs:
                name = attr.lstrip("-!").split("=", 1)[0]
                if name != "linguist-generated":
                    continue
                if attr.startswith("-") or attr.startswith("!") or attr.endswith("=false"):
                    value = False
                else:
                    value = True
                rules.append((gitattributes_pattern(directory, pattern), value))
    return rules


def attribute_generated(rules, path):
    value = False
    for pattern, v in rules:
        if glob_match(pattern, path):
            value = v
    return value


CONFIG_PATH = ".github/yog.json"


def load_config(commit):
    """Repo policy from the base branch tip: never from the PR's head."""
    config = {"sensitive": [], "generated": [], "registries": [], "problems": []}
    data = read_path(commit, CONFIG_PATH)
    if data is None:
        return config
    try:
        raw = json.loads(text(data))
    except ValueError:
        config["problems"].append("%s on the base branch is not valid JSON; ignored" % CONFIG_PATH)
        return config
    if not isinstance(raw, dict):
        config["problems"].append("%s on the base branch is not a JSON object; ignored" % CONFIG_PATH)
        return config
    for key in ("sensitive", "generated", "registries"):
        value = raw.get(key, [])
        if not isinstance(value, list) or not all(isinstance(v, str) and v for v in value):
            config["problems"].append("%s: %r must be a list of strings; ignored" % (CONFIG_PATH, key))
            continue
        config[key] = value if key == "registries" else [g for v in value for g in policy_globs(v)]
    tree = None
    for key in ("sensitive", "generated"):
        for v in raw.get(key, []) if isinstance(raw.get(key), list) else []:
            if not isinstance(v, str):
                continue
            if tree is None:
                tree = list_tree(commit)
            if not any(any_glob(policy_globs(v), p) for p in tree):
                config["problems"].append("%s: %s glob %r matches no file on the base branch" % (CONFIG_PATH, key, v))
    return config


def policy_globs(pattern):
    """A repo-policy glob in the forms people write: leading / anchors, trailing / means
    a folder, a bare name matches that file or folder anywhere."""
    p = pattern.strip()
    anchored = p.startswith("/")
    folder = p.endswith("/")
    p = p.strip("/")
    if folder:
        return [p + "/**"] if anchored or "/" in p else ["**/" + p + "/**"]
    if not anchored and "/" not in p:
        return ["**/" + p, "**/" + p + "/**"]
    return [p, p + "/**"] if not p.endswith("**") else [p]


