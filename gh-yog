PR_URL_RE = re.compile(r"https?://([^/\s]+)/([^/\s]+)/([^/\s]+)/pull/(\d+)")
SAFE_NAME_RE = re.compile(r"^[A-Za-z0-9._-]+$")


def command_name():
    """How to refer to this tool in hints: `gh yog` for the extension, else the path used."""
    invoked = sys.argv[0] if sys.argv and sys.argv[0] else "yog"
    base = os.path.basename(invoked)
    if base == "gh-yog":
        return "gh yog"
    if base == "yog":
        return shlex.quote(invoked)
    return "yog"


class YogError(Exception):
    """A failure to report to the user. Carries an exit code."""

    def __init__(self, msg, code=1):
        Exception.__init__(self, msg)
        self.code = code


def die(msg, code=1):
    raise YogError(msg, code)


# ---------------------------------------------------------------------------
# gh

def gh(args, stdin=None):
    try:
        proc = subprocess.run(["gh"] + args, input=stdin, capture_output=True, text=True)
    except FileNotFoundError:
        die("gh not found. Install the GitHub CLI (https://cli.github.com) and run `gh auth login`.")
    if proc.returncode != 0:
        err = (proc.stderr or proc.stdout).strip()
        die("`gh %s` failed:\n%s" % (" ".join(args[:2]), err))
    return proc.stdout


def gh_json(args):
    return json.loads(gh(args))


def split_repo(value):
    if not value or "/" not in value:
        die("--repo must look like OWNER/NAME")
    owner, name = value.split("/", 1)
    if not SAFE_NAME_RE.match(owner) or not SAFE_NAME_RE.match(name):
        die("--repo must look like OWNER/NAME")
    return owner, name


def resolve_pr(pr_arg, repo_flag):
    """Return (host, owner, repo, number) from a URL, a number, or the current branch."""
    if pr_arg:
        match = PR_URL_RE.search(pr_arg)
        if match:
            return match.group(1), match.group(2), match.group(3), int(match.group(4))
        if pr_arg.lstrip("#").isdigit():
            number = int(pr_arg.lstrip("#"))
            if repo_flag:
                owner, repo = split_repo(repo_flag)
                args = ["repo", "view", "%s/%s" % (owner, repo), "--json", "url", "--jq", ".url"]
            else:
                args = ["repo", "view", "--json", "url", "--jq", ".url"]
            url = gh(args).strip()
            match = re.match(r"https?://([^/\s]+)/([^/\s]+)/([^/\s]+)", url)
            if not match:
                die("could not work out the repository; pass --repo OWNER/NAME")
            return match.group(1), match.group(2), match.group(3), number
        die("could not parse PR %r (give a number or a GitHub PR URL)" % pr_arg)
    args = ["pr", "view", "--json", "url", "--jq", ".url"]
    if repo_flag:
        args += ["--repo", repo_flag]
    url = gh(args).strip()
    match = PR_URL_RE.search(url)
    if not match:
        die("no pull request found for the current branch; pass a PR number or URL")
    return match.group(1), match.group(2), match.group(3), int(match.group(4))


PR_FIELDS = (
    "number,title,body,state,isDraft,url,author,baseRefName,baseRefOid,"
    "headRefName,headRefOid,commits"
)


def fetch_pr_meta(host, owner, repo, number):
    args = ["pr", "view", str(number), "--repo", "%s/%s/%s" % (host, owner, repo), "--json", PR_FIELDS]
    data = gh_json(args)
    commits = data.get("commits") or []
    return {
        "host": host, "owner": owner, "repo": repo, "number": number,
        "url": data.get("url") or "", "title": data.get("title") or "",
        "body": data.get("body") or "", "state": data.get("state") or "",
        "draft": bool(data.get("isDraft")),
        "author": ((data.get("author") or {}).get("login") or ""),
        "base_ref": data.get("baseRefName") or "", "base_oid": data.get("baseRefOid") or "",
        "head_ref": data.get("headRefName") or "", "head_oid": data.get("headRefOid") or "",
        "commit_subjects": [full_subject(c) for c in commits],
    }


def full_subject(commit):
    """GitHub cuts long subjects into headline + body at an ellipsis; join them back."""
    head = commit.get("messageHeadline") or ""
    body = commit.get("messageBody") or ""
    if head.endswith("\u2026") and body.startswith("\u2026"):
        return head[:-1] + body[1:].split("\n", 1)[0]
    return head


def api_merge_base(meta, base_oid, head_oid):
    path = "repos/%s/%s/compare/%s...%s" % (meta["owner"], meta["repo"], base_oid, head_oid)
    args = ["api", path, "--jq", ".merge_base_commit.sha"]
    if meta["host"] != "github.com":
        args = ["api", "--hostname", meta["host"], path, "--jq", ".merge_base_commit.sha"]
    sha = gh(args).strip()
    if not re.match(r"^[0-9a-f]{40,64}$", sha):
        die("GitHub did not return a merge base for this PR")
    return sha


