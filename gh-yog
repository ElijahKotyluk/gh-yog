NPM_REGISTRIES = ("https://registry.npmjs.org/", "https://registry.yarnpkg.com/")
INSTALL_SCRIPTS = ("preinstall", "install", "postinstall", "prepare", "prepublish", "prepack")


def load_json_bytes(data):
    if data is None:
        return None
    try:
        return json.loads(text(data).lstrip("\ufeff"))
    except ValueError:
        return None


META_KEY = "\0meta"


def meta_entry(blob):
    """A pseudo entry for lockfile content outside package entries (root project, importers),
    so that changes there count as accounted for without being reported as packages."""
    return {"version": hashlib.sha256(blob.encode("utf-8", "surrogateescape")).hexdigest(),
            "resolved": None, "integrity": None, "install": False}


def npm_lock_entries(data):
    """{key: {version, resolved, integrity, install}} from package-lock / npm-shrinkwrap."""
    doc = load_json_bytes(data)
    out = {}
    if not isinstance(doc, dict):
        return None
    packages = doc.get("packages")
    root = packages.get("") if isinstance(packages, dict) else None
    out[META_KEY] = meta_entry(json.dumps([doc.get("name"), doc.get("version"), root], sort_keys=True, default=str))
    if isinstance(packages, dict):
        for key, entry in packages.items():
            if not key or not isinstance(entry, dict) or entry.get("link"):
                continue
            out[key] = {"version": entry.get("version"), "resolved": entry.get("resolved"),
                        "integrity": entry.get("integrity"), "install": bool(entry.get("hasInstallScript")),
                        "alias": entry.get("name") if isinstance(entry.get("name"), str) else None,
                        "local": "node_modules/" not in key}
        return out

    def walk(deps, prefix):
        for name, entry in (deps or {}).items():
            if not isinstance(entry, dict):
                continue
            key = prefix + "node_modules/" + name
            version = entry.get("version")
            resolved = entry.get("resolved")
            if isinstance(version, str) and re.search(r"[:/]", version):
                resolved = resolved or version
            out[key] = {"version": version, "resolved": resolved,
                        "integrity": entry.get("integrity"), "install": False}
            walk(entry.get("dependencies"), key + "/")
    walk(doc.get("dependencies"), "")
    return out


def strip_yaml_comment(line):
    out, quote = [], None
    for i, ch in enumerate(line):
        if quote:
            if ch == quote:
                quote = None
        elif ch in "'\"":
            quote = ch
        elif ch == "#" and (i == 0 or line[i - 1] in " \t"):
            break
        out.append(ch)
    return "".join(out).rstrip()


def yaml_pairs(fragment):
    """key: value pairs from an inline {a: b, c: d} map or a single `key: value` line."""
    fragment = fragment.strip().lstrip("{").rstrip("}")
    out = {}
    for part in fragment.split(","):
        if ":" in part:
            k, v = part.split(":", 1)
            out[k.strip().strip("'\"")] = v.strip().strip("'\"")
    return out


PNPM_ENTRY_RE = re.compile(r"^(['\"]?)(/?[^\s'\"{}]+)\1:\s*(.*)$")
FLOW_RESOLUTION_RE = re.compile(r"resolution:\s*(?:&\S+\s*)?\{([^}]*)\}")


def pnpm_lock_entries(data):
    """{name@version: {...}} from the packages section of pnpm-lock.yaml (line based).
    Handles block and flow entries at any indent, anchors and comments."""
    out = {}
    if data is None:
        return out
    section, key, res_indent, entry_indent = None, None, None, None
    lines, buf = [], None
    for raw in text(data).lstrip("\ufeff").splitlines():
        line = strip_yaml_comment(raw)
        if buf is not None:
            buf += " " + line.strip()
            if buf.count("{") <= buf.count("}"):
                lines.append(buf)
                buf = None
            continue
        if line.count("{") > line.count("}"):
            buf = line
            continue
        lines.append(line)
    if buf is not None:
        return None
    meta = []
    for line in lines:
        line = re.sub(r"^(\s*)(['\"])([\w-]+)\2:", r"\1\3:", line)
        if not line.strip():
            continue
        indent = len(line) - len(line.lstrip(" "))
        if indent == 0:
            section, key, res_indent, entry_indent = line.rstrip(":").strip(), None, None, None
            if section != "packages":
                meta.append(line)
            continue
        if section != "packages":
            meta.append(line)
            continue
        if entry_indent is None:
            entry_indent = indent
        stripped = line.strip()
        if indent == entry_indent:
            match = PNPM_ENTRY_RE.match(stripped)
            if not match:
                return None
            key = match.group(2).lstrip("/")
            if "@" not in key[1:]:
                v5 = re.match(r"^(@?[^/]+(?:/[^/@]+)?)/(\d[^/]*)$", key)
                if v5:
                    key = "%s@%s" % (v5.group(1), v5.group(2))
            at = key.rfind("@")
            version = key[at + 1:] if at > 0 else ""
            out[key] = {"version": version.split("(")[0], "resolved": None, "integrity": None, "install": False}
            res_indent = None
            rest = match.group(3).strip()
            if rest.startswith("&"):
                rest = rest.split(None, 1)[1] if " " in rest else ""
            if rest.startswith("{"):
                inline = FLOW_RESOLUTION_RE.search(rest)
                if inline:
                    apply_resolution(out[key], yaml_pairs(inline.group(1)))
                if re.search(r"requiresBuild:\s*true\b", rest):
                    out[key]["install"] = True
            elif rest:
                return None
            continue
        if key is None or indent < entry_indent:
            return None
        if res_indent is not None and indent <= res_indent:
            res_indent = None
        if stripped.startswith("resolution:"):
            rest = re.sub(r"^resolution:\s*(?:&\S+\s*)?", "", stripped)
            if rest.startswith("*"):
                return None
            if rest:
                pairs = yaml_pairs(rest)
                if any(not v or v.startswith("*") for v in pairs.values()):
                    return None
                apply_resolution(out[key], pairs)
            else:
                res_indent = indent
            continue
        if res_indent is not None:
            pairs = yaml_pairs(stripped)
            if not pairs or any(not v or v.startswith("*") for v in pairs.values()):
                return None
            apply_resolution(out[key], pairs)
            continue
        if re.match(r"^requiresBuild:\s*true\b", stripped):
            out[key]["install"] = True
    out[META_KEY] = meta_entry("\n".join(meta))
    return out


def apply_resolution(entry, pairs):
    if "integrity" in pairs:
        entry["integrity"] = pairs["integrity"]
    if "tarball" in pairs:
        entry["resolved"] = pairs["tarball"]
    if "repo" in pairs or pairs.get("type") == "git" or "commit" in pairs:
        entry["resolved"] = "git+" + (pairs.get("repo") or "?")
    if "directory" in pairs or pairs.get("type") == "directory" or "path" in pairs:
        entry["resolved"] = "file:" + (pairs.get("directory") or pairs.get("path") or "?")


def yarn_lock_entries(data):
    """{name@version: {...}} from a yarn v1 lockfile. Yarn 2+ lockfiles return None."""
    if data is None:
        return {}
    body = text(data)
    if re.search(r"^__metadata:", body, re.MULTILINE):
        return UNSUPPORTED
    out, name, entry = {}, None, None
    for line in body.splitlines():
        if not line.strip() or line.startswith("#"):
            continue
        if not line.startswith(" "):
            name = line.rstrip(":").strip()
            first = name.split(",")[0].strip().strip('"')
            alias = None
            if "@npm:" in first:
                target = first.split("@npm:", 1)[1]
                at = target.rfind("@")
                alias = target[:at] if at > 0 else target
            entry = {"version": None, "resolved": None, "integrity": None, "install": False, "alias": alias}
            out[name] = entry
            continue
        if entry is None:
            continue
        m = re.match(r'^\s+("(?:[^"\\]|\\.)*"|\S+)\s+(.*)$', line)
        if not m:
            continue
        field = m.group(1)
        if field.startswith('"'):
            try:
                field = json.loads(field)
            except ValueError:
                return None
        value = m.group(2).strip()
        if value.startswith('"') and value.endswith('"'):
            try:
                value = json.loads(value)
            except ValueError:
                value = value.strip('"')
        if field == "version":
            entry["version"] = value
        elif field == "resolved":
            entry["resolved"] = value.split("#")[0]
        elif field == "integrity":
            entry["integrity"] = value
    out = dict((k, v) for k, v in out.items() if v["version"] is not None)
    if not out and re.search(r"^\s+version", body, re.MULTILINE):
        return None
    return out


UNSUPPORTED = "unsupported"
LOCK_SOURCE_KEY_RE = re.compile(r"\b(?:resolved|tarball|resolution|repo)\b|@(?:https?:|git\+|file:|link:)")
LOCK_REMOTE_RE = re.compile(r"(?:[a-z][a-z0-9+.-]*://|git\+|file:)[^\s\"',}]+")
LOCK_INFO_RE = re.compile(r"^\s*\"?(?:deprecated|funding|url|homepage|bugs|description|license)\"?\s*[:\s]")
LOCK_URL_RE = re.compile(r"(?:[a-z][a-z0-9+.-]*://|git\+|file:|link:)[^\s\"',}]+")
LOCK_PARSERS = {
    "package-lock.json": npm_lock_entries, "npm-shrinkwrap.json": npm_lock_entries,
    "pnpm-lock.yaml": pnpm_lock_entries, "yarn.lock": yarn_lock_entries,
}


def lock_name(key):
    """The package name of a lockfile key: npm paths, pnpm name@version, yarn spec lines."""
    k = key.split("node_modules/")[-1] if "node_modules/" in key else key
    k = k.split(",")[0].strip().strip('"').split("(")[0].split("@npm:")[0]
    at = k.rfind("@")
    return k[:at] if at > 0 else k


SCOPED_TARBALL_RE = re.compile(r"^[a-z]+://[^?#]*/(@[^/]+/[^/]+)/-/[^/]+\.tgz(?:[?#].*)?$")
TARBALL_RE = re.compile(r"^[a-z]+://[^?#]*/([^/@][^/]*)/-/[^/]+\.tgz(?:[?#].*)?$")


def tarball_name(url):
    """The package name in a registry tarball URL (/<name>/-/<file>.tgz), or None."""
    url = urllib.parse.unquote(url or "")
    m = SCOPED_TARBALL_RE.match(url) or TARBALL_RE.match(url)
    return m.group(1) if m else None


def registry_ok(url, extra=()):
    allowed = list(NPM_REGISTRIES) + [r if r.endswith("/") else r + "/" for r in extra]
    return not url or any(url.startswith(r) for r in allowed)


def lockfile_review(f, old_data, new_data, manifest_changed, units, flags, registries=(), dep_texts=()):
    """Compare a lockfile's entries at base and head. Returns a short summary."""
    parser = LOCK_PARSERS.get(os.path.basename(f["path"] or f["old_path"]))
    if f["status"] == "D":
        flags.add("lockfile-unaccounted", f["index"], [u["id"] for u in units], "lockfile deleted")
        return None
    if parser is None:
        flags.add("lockfile-unparsed", f["index"], [u["id"] for u in units])
        return None
    old = parser(old_data) if old_data is not None else {}
    new = parser(new_data)
    if UNSUPPORTED in (old, new):
        flags.add("lockfile-unparsed", f["index"], [u["id"] for u in units])
        return None
    if old is None or new is None:
        flags.add("lockfile-unaccounted", f["index"], [u["id"] for u in units], "could not parse it")
        return None
    ids, idx = [u["id"] for u in units], f["index"]
    added = sorted(k for k in new if k not in old and k != META_KEY)
    removed = sorted(k for k in old if k not in new and k != META_KEY)
    changed = []
    for key in sorted(set(old) & set(new) - set([META_KEY])):
        a, b = old[key], new[key]
        if a["version"] != b["version"]:
            changed.append(key)
            continue
        if (a["integrity"] and b["integrity"] and a["integrity"] != b["integrity"]) or \
                (a["resolved"] and b["resolved"] and a["resolved"] != b["resolved"]):
            flags.add("lockfile-integrity", idx, ids, clean_line(key))
    for key in added + changed:
        entry = new[key]
        if not registry_ok(entry["resolved"], registries):
            flags.add("lockfile-source", idx, ids, "%s from %s" % (clean_line(key), clean_line(entry["resolved"])[:80]))
        before = old.get(key)
        if entry["install"] and not (before and before["install"]):
            flags.add("dep-install-script", idx, ids, clean_line(key))
    for key in sorted(set(new) - set([META_KEY])):
        entry, before = new[key], old.get(key)
        if before == entry:
            continue
        expected = entry.get("alias") or lock_name(key)
        got = tarball_name(entry["resolved"])
        if got and got != expected:
            flags.add("lockfile-identity", idx, ids, "%s resolves to %s" % (clean_line(key), clean_line(got)))
        alias = entry.get("alias")
        if alias and alias != lock_name(key) and (not before or before.get("alias") != alias) and \
                not any(("npm:%s@" % alias) in t for t in dep_texts):
            flags.add("lockfile-identity", idx, ids, "%s is now an alias of %s" % (clean_line(key), clean_line(alias)))
    old_names = set(lock_name(k) for k in old)
    new_names = sorted(set(
        lock_name(k) for k in added if lock_name(k) not in old_names and not new[k].get("local")
        and not (new[k]["resolved"] or "").startswith(("file:", "link:"))))
    if new_names:
        detail = "%d new package%s, e.g. %s" % (len(new_names), "" if len(new_names) == 1 else "s",
                                               clean_line(new_names[0]))
        flags.add("lockfile-new-packages" if manifest_changed else "lockfile-unexplained", idx, ids, detail)
    moved = any(old[k] != new[k] for k in set(old) & set(new)) or (META_KEY in old) != (META_KEY in new)
    for kind, _, new_no, line in units[0]["lines"]:
        if kind != "+" or LOCK_INFO_RE.search(line):
            continue
        urls = LOCK_URL_RE.findall(line) if LOCK_SOURCE_KEY_RE.search(line) else LOCK_REMOTE_RE.findall(line)
        for url in urls:
            if not registry_ok(url, registries):
                flags.add("lockfile-source", idx, ids, "+%d %s" % (new_no, clean_line(url)[:80]))
    if not added and not removed and not moved and (units[0]["added"] or units[0]["removed"]):
        flags.add("lockfile-unaccounted", idx, ids, "lines changed but no package entry did")
    return {"added": len(added), "removed": len(removed), "changed": len(changed)}


NPM_SOURCE_RE = re.compile(r"^(?:git\+|git:|https?:|file:|link:|github:|gitlab:|bitbucket:|gist:)|"
                           r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:#.*)?$")
DEP_SECTIONS = ("dependencies", "devDependencies", "peerDependencies", "optionalDependencies",
                "overrides", "resolutions", "bundleDependencies", "bundledDependencies")


def dep_changes(path, old_data, new_data):
    """(dependency changes as strings, install-script changes as (key, value)) for a manifest."""
    base = os.path.basename(path)
    out, scripts = [], []
    if base == "package.json":
        old = load_json_bytes(old_data) or {}
        new = load_json_bytes(new_data) or {}
        if not isinstance(old, dict):
            old = {}
        if not isinstance(new, dict):
            new = {}
        for section in DEP_SECTIONS + ("pnpm.overrides",):
            pick = lambda d: (d.get("pnpm") or {}).get("overrides") if section == "pnpm.overrides" and isinstance(d.get("pnpm"), dict) else d.get(section)
            a, b = pick(old), pick(new)
            a = dict((x, True) for x in a if isinstance(x, str)) if isinstance(a, list) else a
            b = dict((x, True) for x in b if isinstance(x, str)) if isinstance(b, list) else b
            a = a if isinstance(a, dict) else {}
            b = b if isinstance(b, dict) else {}
            for name in sorted(b):
                if isinstance(b[name], str) and a.get(name) != b[name] and NPM_SOURCE_RE.search(b[name]):
                    scripts.append(("package source", "%s: %s" % (name, b[name])))
            for name in sorted(set(a) | set(b)):
                if name not in a:
                    out.append("+ %s %s (%s)" % (name, b[name], section))
                elif name not in b:
                    out.append("- %s (%s)" % (name, section))
                elif a[name] != b[name]:
                    out.append("~ %s %s -> %s (%s)" % (name, a[name], b[name], section))
        sa = old.get("scripts") if isinstance(old.get("scripts"), dict) else {}
        sb = new.get("scripts") if isinstance(new.get("scripts"), dict) else {}
        for key in INSTALL_SCRIPTS:
            if sa.get(key) != sb.get(key) and sb.get(key) is not None:
                scripts.append((key, str(sb.get(key))))
    elif base.endswith(".txt") or base in ("go.mod", "pnpm-workspace.yaml"):
        a = set(l.strip() for l in split_lines(old_data or b"") if l.strip() and not l.strip().startswith(("#", "//")))
        b = set(l.strip() for l in split_lines(new_data or b"") if l.strip() and not l.strip().startswith(("#", "//")))
        out += ["+ " + l for l in sorted(b - a)] + ["- " + l for l in sorted(a - b)]
        for l in sorted(b - a):
            if REQ_SOURCE_RE.search(l):
                scripts.append(("package source", l))
    return [clean_line(str(o)) for o in out], scripts


REQ_SOURCE_RE = re.compile(r"^(?:--(?:extra-)?index-url\b|-i\s|--find-links\b|-f\s|--trusted-host\b)|"
                           r"\s@\s*\S+://|^(?:git|hg|svn|bzr)\+|^\S+://")


def manifest_review(f, old_data, new_data, units, flags):
    """Dependency changes in a manifest, as short strings; flags install-script changes."""
    ids, idx = [u["id"] for u in units], f["index"]
    out, scripts = dep_changes(f["path"] or f["old_path"], old_data, new_data)
    for key, value in scripts:
        code = "registry-config" if key == "package source" else "install-script"
        flags.add(code, idx, ids, "%s: %s" % (key, clean_line(value)[:80]))
    if out:
        flags.add("dependency", idx, ids, "%d change%s" % (len(out), "" if len(out) == 1 else "s"))
    return out


