# cli

def build_parser():
    p = argparse.ArgumentParser(prog=command_name(), description="A review brief for a pull request.")
    p.add_argument("--version", action="version", version="yog %s" % VERSION)
    sub = p.add_subparsers(dest="cmd")

    c = sub.add_parser("collect", help="fetch a PR or take local commits; compute facts; write a brief template")
    c.add_argument("pr", nargs="?", help="PR number or URL (default: the current branch's PR)")
    c.add_argument("--repo", help="OWNER/NAME when giving a PR number outside its checkout")
    c.add_argument("--base", help="local mode: base branch or commit")
    c.add_argument("--head", help="local mode: head commit (default HEAD)")
    c.add_argument("--allow-merged", action="store_true", help="brief a merged or closed PR (for evaluation)")
    c.add_argument("--dir", help="where to write facts.json and brief.json (default: inside the git dir)")
    c.set_defaults(func=cmd_collect)

    c = sub.add_parser("facts", help="print the computed facts, no AI")
    c.add_argument("facts", help="facts.json written by collect")
    c.add_argument("-f", "--format", choices=("term", "md", "json"), default="term")
    c.set_defaults(func=cmd_facts)

    c = sub.add_parser("hunks", help="print units with line numbers")
    c.add_argument("facts", help="facts.json written by collect")
    c.add_argument("ids", nargs="+", help="unit ids: F (whole file), F.H, F.H.C, or all")
    c.add_argument("--max-lines", type=int, default=200, help="lines shown for a lockfile (default 200)")
    c.set_defaults(func=cmd_hunks)

    c = sub.add_parser("show", help="print a file at the PR's head (or base) with line numbers")
    c.add_argument("facts", help="facts.json written by collect")
    c.add_argument("path", help="file path in the repository")
    c.add_argument("--lines", help="A-B, a line range")
    c.add_argument("--base", action="store_true", help="the merge base version instead of the head")
    c.set_defaults(func=cmd_show)

    for name, func, helptext in (("check", cmd_check, "recompute the facts and validate a brief"),
                                 ("render", cmd_render, "check a brief, then print it")):
        c = sub.add_parser(name, help=helptext)
        c.add_argument("brief", help="brief.json")
        c.add_argument("pr", nargs="?", help="the PR the brief must be for (default: the current branch's PR)")
        c.add_argument("--repo", help="OWNER/NAME when giving a PR number outside its checkout")
        c.add_argument("--base", help="local mode: the base the brief must be for")
        c.add_argument("--head", help="local mode: the head the brief must be for (default HEAD)")
        c.add_argument("--allow-merged", action="store_true", help="accept a merged or closed PR")
        if name == "render":
            c.add_argument("-f", "--format", choices=("term", "md"), default="term")
        c.set_defaults(func=func)
    return p


def main(argv=None):
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(errors="backslashreplace")
        except (AttributeError, ValueError):
            pass
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "func", None):
        parser.print_help()
        return 2
    try:
        return args.func(args)
    except YogError as exc:
        sys.stderr.write("%s: %s\n" % (command_name(), exc))
        return exc.code
    except KeyboardInterrupt:
        sys.stderr.write("interrupted\n")
        return 130


if __name__ == "__main__":
    sys.exit(main())
