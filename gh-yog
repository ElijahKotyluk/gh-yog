# facts

def blob_data(reader, mode, sha):
    if not sha or blob_kind(mode) not in ("file", "symlink"):
        return None
    return reader.read(sha)


def compute_facts(ctx):
    """Every computed fact for a diff. ctx: mode, pr (metadata or None), base_tip,
    merge_base, head, subjects (local mode). Deterministic for the same commits."""
    base_tip, merge_base, head = ctx["base_tip"], ctx["merge_base"], ctx["head"]
    config = load_config(base_tip)
    attr_rules = load_generated_attributes(base_tip, list_tree(base_tip))
    changes = raw_changes(merge_base, head)
    head_tree = list_tree(head)
    changed_paths = set(c["path"] for c in changes if c["path"])
    reader = BlobReader()
    try:
        blobs = [(blob_data(reader, c["old_mode"], c["old_blob"]), blob_data(reader, c["new_mode"], c["new_blob"]))
                 for c in changes]
    finally:
        reader.close()
    dep_dirs, dep_texts = [], []
    for c, (old_data, new_data) in zip(changes, blobs):
        p = c["path"] or c["old_path"]
        if os.path.basename(p) in ("package.json", "pnpm-workspace.yaml"):
            changed = dep_changes(p, old_data, new_data)[0]
            if changed:
                dep_dirs.append(os.path.dirname(p))
                dep_texts.extend(changed)
    binaries = [any(d is not None and looks_binary(d) for d in pair) for pair in blobs]

    def hunks_for(i):
        c, (old_data, new_data) = changes[i], blobs[i]
        if binaries[i] or MODE_SUBMODULE in (c["old_mode"], c["new_mode"]):
            return []
        return file_hunks(c, old_data, new_data)
    try:
        import concurrent.futures
        with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
            all_hunks = list(pool.map(hunks_for, range(len(changes))))
    except (ImportError, RuntimeError):
        all_hunks = [hunks_for(i) for i in range(len(changes))]
    flags = FlagSet()
    files, units = [], []
    for idx, c in enumerate(changes, 1):
        path = c["path"] or c["old_path"]
        old_data, new_data = blobs[idx - 1]
        kinds = set(k for k in (blob_kind(c["old_mode"]), blob_kind(c["new_mode"])) if k)
        binary = "file" in kinds and binaries[idx - 1]
        if "submodule" in kinds:
            cls = "submodule"
        elif kinds == set(["symlink"]):
            cls = "symlink"
        else:
            cls = classify(path, binary)
        trusted = attribute_generated(attr_rules, path) or any_glob(config["generated"], path)
        if trusted and c["status"] in "RC":
            trusted = (c["old_blob"] == c["new_blob"]) and (
                attribute_generated(attr_rules, c["old_path"]) or any_glob(config["generated"], c["old_path"]))
        generated_base = bool(
            old_data is not None and c["status"] == "M" and not binary
            and has_generated_marker(old_data))
        claims_generated = bool(
            not trusted and not generated_base and c["status"] != "D" and not binary
            and (has_generated_marker(new_data) or any_glob(GENERATED_NAME_GLOBS, path)))
        f = dict(c)
        old_cls = classify(c["old_path"], binary) if c["old_path"] and cls not in ("submodule", "symlink") else cls
        f.update({
            "index": idx, "class": cls, "old_class": old_cls, "binary": binary, "generated_trusted": trusted,
            "generated_base": generated_base, "claims_generated": claims_generated,
            "link_target": clean_line(text(new_data)) if blob_kind(c["new_mode"]) == "symlink" and new_data is not None else None,
        })
        text_ok = not binary and cls != "submodule"
        hunks = all_hunks[idx - 1] if text_ok else []
        file_units = make_units(idx, hunks, splittable=(cls != "lockfile"))
        if cls == "lockfile":
            whole = file_units[0]
            for u in file_units[1:]:
                whole["lines"].extend(u["lines"])
                whole["added"] += u["added"]
                whole["removed"] += u["removed"]
            file_units = [whole]
        f["head_lines"] = len(split_lines(new_data)) if text_ok and new_data is not None else 0
        f["base_lines"] = len(split_lines(old_data)) if text_ok and old_data is not None else 0
        f["added"] = sum(u["added"] for u in file_units)
        f["removed"] = sum(u["removed"] for u in file_units)
        file_flags(f, file_units, flags, config)
        if cls != "lockfile":
            scan_lines(f, file_units, flags)
        else:
            for kind, _, new_no, line in file_units[0]["lines"]:
                if kind == "+" and line_hidden(line, new_no == 1):
                    flags.add("hidden-text", idx, [file_units[0]["id"]], "+%d %s" % (new_no, char_codes(line_hidden(line, new_no == 1))))
        lock_dir = os.path.dirname(path)
        manifest_changed = any(d == lock_dir or not lock_dir or d.startswith(lock_dir + "/") for d in dep_dirs)
        f["lock"] = lockfile_review(f, old_data, new_data, manifest_changed, file_units, flags,
                                    config["registries"], dep_texts) if cls == "lockfile" else None
        f["deps"] = manifest_review(f, old_data, new_data, file_units, flags) if is_manifest(path) else []
        files.append(f)
        units.extend(file_units)

    pr = ctx.get("pr")
    if pr:
        title, body, subjects = pr["title"], pr["body"], pr["commit_subjects"]
    else:
        title, body, subjects = "", "", ctx.get("subjects", [])
    for s in [title, body] + list(subjects):
        if s and AI_RE.search(s):
            flags.add("ai-addressed", None, [], "in the PR title, description or a commit message")
            break
    claims, claims_dropped = extract_claims(title, body, subjects)

    flag_list = flags.listing()
    flagged_files = set(e["file"] for e in flag_list if e["file"])
    unit_flags = {}
    for e in flag_list:
        for uid in e["units"]:
            unit_flags.setdefault(uid, []).append(e["code"])
    for f in files:
        reason = None
        if f["index"] in flagged_files:
            reason = None
        elif f["class"] == "lockfile":
            reason = "lockfile"
        elif f["generated_trusted"]:
            reason = "generated (base branch policy)"
        elif f["generated_base"]:
            reason = "generated (already generated on the base branch)"
        elif (f["status"] == "R" and f["similarity"] == 100 and f["old_blob"] == f["new_blob"]
              and f["old_mode"] == f["new_mode"]
              and os.path.splitext(f["old_path"])[1] == os.path.splitext(f["path"])[1]
              and f["class"] in ("docs", "asset") and f["old_class"] == f["class"]
              and not any_glob(SENSITIVE_GLOBS, f["old_path"]) and not any_glob(SENSITIVE_GLOBS, f["path"])):
            reason = "pure rename"
        f["mechanical"] = reason
    by_index = dict((f["index"], f) for f in files)
    for u in units:
        f = by_index[u["file"]]
        u["flags"] = sorted(set(unit_flags.get(u["id"], [])))
        if f["mechanical"]:
            u["required"] = False
        elif u["kind"] == "file":
            u["required"] = not any(v["file"] == u["file"] and v["kind"] == "hunk" for v in units)
        else:
            u["required"] = True

    sources = [f["path"] for f in files if f["class"] == "source" and f["status"] != "D" and not f["mechanical"]]
    pairing = pair_tests(sources, head_tree, changed_paths)
    for f in files:
        f["pairing"] = pairing.get(f["path"]) if f["class"] == "source" else None

    lockfiles = set(f["index"] for f in files if f["class"] == "lockfile")
    for u in units:
        u["lines_counted"] = 0 if u["file"] in lockfiles else u["added"] + u["removed"]
    review_lines = sum(u["lines_counted"] for u in units if u["required"])
    totals = {
        "files": len(files), "added": sum(f["added"] for f in files), "removed": sum(f["removed"] for f in files),
        "review_files": len([f for f in files if not f["mechanical"]]),
        "mechanical_files": len([f for f in files if f["mechanical"]]),
        "review_lines": review_lines,
        "required_units": len([u for u in units if u["required"]]),
        "large": review_lines >= LARGE_PR_LINES,
    }
    return {
        "schema": FACTS_SCHEMA, "yog": VERSION, "mode": ctx["mode"],
        "pr": dict((k, v) for k, v in (pr or {}).items() if k != "body") if pr else None,
        "base_tip": base_tip, "merge_base": merge_base, "head": head,
        "config_problems": config["problems"],
        "files": files, "units": units, "flags": flag_list,
        "claims": claims, "claims_dropped": claims_dropped, "totals": totals,
    }


FILE_KEYS = ("index", "path", "old_path", "status", "class", "binary", "old_mode", "new_mode", "head_lines", "base_lines",
             "added", "removed", "mechanical", "pairing", "deps", "lock", "link_target")
UNIT_KEYS = ("id", "file", "kind", "head", "base", "added", "removed", "required", "flags")


def facts_json(facts):
    out = dict(facts)
    out["files"] = [dict((k, f.get(k)) for k in FILE_KEYS) for f in facts["files"]]
    for f in out["files"]:
        f["path"] = clean_line(f["path"]) if f["path"] else None
        f["old_path"] = clean_line(f["old_path"]) if f["old_path"] else None
    out["units"] = [dict((k, u.get(k)) for k in UNIT_KEYS) for u in facts["units"]]
    if out.get("pr"):
        out["pr"] = dict(out["pr"])
        out["pr"]["title"] = clean_line(out["pr"]["title"])
        out["pr"]["commit_subjects"] = [clean_line(s) for s in out["pr"]["commit_subjects"]]
    out["claims"] = [dict(c, text=clean_line(c["text"])) for c in facts["claims"]]
    return out


