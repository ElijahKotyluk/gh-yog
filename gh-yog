# facts, hunks, show

def facts_from_file(path):
    data = load_json_file(path, "facts")
    if not isinstance(data, dict) or not all(
            isinstance(data.get(k), str) and SHA_RE.match(data[k]) for k in ("base_tip", "merge_base", "head")):
        die("%s is not a yog facts file" % path)
    for k in ("base_tip", "merge_base", "head"):
        if not has_commit(data[k]):
            die("commit %s from %s is not in this repository; run collect again" % (data[k][:12], path))
    pr = data.get("pr")
    if pr is not None:
        ok = isinstance(pr, dict) and all(isinstance(pr.get(k), str) for k in ("owner", "repo", "title", "url"))
        ok = ok and isinstance(pr.get("number"), int) and isinstance(pr.get("commit_subjects", []), list)
        if not ok:
            die("%s is not a yog facts file (bad pr field)" % path)
        pr = dict(pr, commit_subjects=[str(x) for x in pr.get("commit_subjects") or []])
    ctx = {"mode": "pr" if pr else "local", "base_tip": data["base_tip"], "merge_base": data["merge_base"],
           "head": data["head"], "pr": None, "subjects": []}
    if pr:
        ctx["pr"] = dict(pr, body="", commit_subjects=pr.get("commit_subjects") or [])
    return compute_facts(ctx)


def cmd_facts(args):
    facts = facts_from_file(args.facts)
    if args.format == "json":
        json.dump(facts_json(facts), sys.stdout, indent=2, ensure_ascii=True)
        sys.stdout.write("\n")
        return 0
    md = args.format == "md"
    r = Renderer(facts, {"groups": [], "claims": {}}, "md" if md else "term")
    t = facts["totals"]
    r.out("## yog facts" if md else "YOG FACTS (computed, no AI)")
    r.out("%d files, +%d -%d. %d lines in %d files need review; %d files are mechanical." % (
        t["files"], t["added"], t["removed"], t["review_lines"], t["review_files"], t["mechanical_files"]))
    r.hard_flags()
    r.section("Files", "computed")
    for f in facts["files"]:
        if f["mechanical"]:
            continue
        hints = sorted(set(e["code"] for e in facts["flags"] if e["file"] == f["index"] and e["tier"] == "hint"))
        bits = [f["class"], f["status"]]
        if f.get("pairing"):
            bits.append("test file: " + f["pairing"]["status"])
        if hints:
            bits.append("hints: " + ", ".join(hints))
        r.bullet("%d %s +%d -%d (%s)" % (f["index"], r.code(f["path"] or f["old_path"]), f["added"], f["removed"], "; ".join(bits)))
    r.mechanical()
    r.dependencies()
    sys.stdout.write("\n".join(r.lines).rstrip() + "\n")
    return 0


def select_units(facts, ids):
    units = facts["units"]
    if ids == ["all"]:
        return units
    out = []
    ids = [i for raw in ids for i in raw.split(",") if i]
    for want in ids:
        if not re.match(r"^\d+(?:\.\d+){0,2}$", want):
            die("%r is not a unit id (F, F.H or F.H.C, or all)" % want)
        hit = [u for u in units if u["id"] == want or u["id"].startswith(want + ".")]
        if not hit:
            die("no unit %s in this diff" % want)
        out.extend(u for u in hit if u not in out)
    return out


def cmd_hunks(args):
    facts = facts_from_file(args.facts)
    files = dict((f["index"], f) for f in facts["files"])
    for u in select_units(facts, args.ids):
        f = files[u["file"]]
        path = clean_line(f["path"] or f["old_path"])
        if f["status"] in "RC" and f["old_path"] != f["path"]:
            path = "%s (from %s)" % (path, clean_line(f["old_path"]))
        flags = (" flags: " + ", ".join(u["flags"])) if u["flags"] else ""
        if u["kind"] == "file":
            print("== %s  %s  [%s %s%s]%s" % (u["id"], path, f["class"], f["status"],
                                                ", mechanical: " + f["mechanical"] if f["mechanical"] else "", flags))
            if f.get("link_target"):
                print("   symlink -> %s" % f["link_target"])
            if f["class"] == "lockfile" and u["lines"]:
                print("   lockfile diff, %d lines; first %d shown" % (len(u["lines"]), min(len(u["lines"]), args.max_lines)))
                lines = u["lines"][:args.max_lines]
            else:
                continue
        else:
            print("== %s  %s  head %s  base %s%s" % (
                u["id"], path, "%d-%d" % tuple(u["head"]) if u["head"] else "-",
                "%d-%d" % tuple(u["base"]) if u["base"] else "-", flags))
            lines = u["lines"]
        for kind, old_no, new_no, line in lines:
            left = ("+%d" % new_no) if kind == "+" else ("-%d" % old_no) if kind == "-" else (" %d" % new_no)
            print("%7s %s %s" % (left, kind if kind != " " else "|", clean(line)))
    return 0


def cmd_show(args):
    data = load_json_file(args.facts, "facts")
    commit = data.get("merge_base") if isinstance(data, dict) and args.base else (data.get("head") if isinstance(data, dict) else None)
    if not isinstance(commit, str) or not SHA_RE.match(commit) or not has_commit(commit):
        die("the facts file's commits are not in this repository; run collect again")
    blob = read_path(commit, args.path)
    if blob is None:
        die("%s is not a file at the %s commit %s" % (args.path, "base" if args.base else "head", commit[:12]))
    if looks_binary(blob):
        die("%s is binary" % args.path)
    lines = split_lines(blob)
    lo, hi = 1, len(lines)
    if args.lines:
        match = re.match(r"^(\d+)-(\d+)$", args.lines)
        if not match:
            die("--lines must look like A-B")
        lo, hi = max(1, int(match.group(1))), min(len(lines), int(match.group(2)))
    for n in range(lo, hi + 1):
        print("%6d  %s" % (n, clean(lines[n - 1])))
    return 0


