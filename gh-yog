def words_in(s):
    out = set()
    for token in re.findall(r"[A-Za-z]+", s):
        for w in WORD_RE.findall(token):
            out.add(w.lower())
    return out


def scripts_of(token):
    found = set()
    for ch in token:
        if ch.isalpha():
            name = unicodedata.name(ch, "")
            script = name.split(" ")[0] if name else ""
            if script in CONFUSABLE_SCRIPTS:
                found.add(script)
    return found


def line_hidden(line, first_line):
    s = line[1:] if first_line and line.startswith("\ufeff") else line
    return [s[i] for i in hidden_positions(s, allow_emoji_zwj=True)]


class FlagSet(object):
    def __init__(self):
        self.items = {}

    def add(self, code, file_index, units, detail=None):
        key = (code, file_index)
        entry = self.items.get(key)
        if entry is None:
            tier, title = FLAGS[code]
            entry = self.items[key] = {"code": code, "tier": tier, "title": title,
                                       "file": file_index, "units": [], "details": []}
        for u in units:
            if u not in entry["units"]:
                entry["units"].append(u)
        if detail and detail not in entry["details"] and len(entry["details"]) < 5:
            entry["details"].append(detail)

    def listing(self):
        def order(e):
            return (0 if e["tier"] == "hard" else 1, e["file"] or 0, e["code"])
        return sorted(self.items.values(), key=order)


def cite(unit, kind, number):
    return "%s:%s%d" % (unit["id"], "+" if kind == "+" else "-", number)


def scan_lines(f, units, flags):
    """Line-level flags for one file's text units."""
    cls = f["class"]
    assert_added = assert_removed = 0
    for unit in units:
        if unit["kind"] != "hunk":
            continue
        for kind, old_no, new_no, line in unit["lines"]:
            if kind == "-":
                if cls == "test" and ASSERT_RE.search(line):
                    assert_removed += 1
                continue
            if kind != "+":
                continue
            ref = cite(unit, "+", new_no)
            bad = line_hidden(line, new_no == 1)
            if bad:
                flags.add("hidden-text", f["index"], [unit["id"]], "%s %s" % (ref, char_codes(bad)))
            if cls in ("lockfile",):
                continue
            for token in IDENT_RE.findall(line):
                if len(scripts_of(token)) > 1:
                    flags.add("mixed-script", f["index"], [unit["id"]], "%s %s" % (ref, clean_line(token)))
                elif cls != "docs" and any(ch in HOMOGLYPHS for ch in token) and all(
                        ord(ch) < 128 or ch in HOMOGLYPHS for ch in token):
                    flags.add("homoglyph", f["index"], [unit["id"]], "%s %s" % (ref, clean_line(token)))
            if AI_RE.search(line):
                flags.add("ai-addressed", f["index"], [unit["id"]], ref)
            if cls == "docs":
                continue
            if SKIP_RE.search(line) and cls in ("test", "source", "config", "ci", "manifest"):
                flags.add("test-skip", f["index"], [unit["id"]], ref)
            if SUPPRESS_RE.search(line):
                flags.add("suppression", f["index"], [unit["id"]], ref)
            if cls == "test" and ASSERT_RE.search(line):
                assert_added += 1
            if cls in ("source", "ci", "manifest", "config"):
                if DANGER_RE.search(line):
                    flags.add("dangerous-call", f["index"], [unit["id"]], ref)
                hit = sorted(words_in(line) & SENSITIVE_WORDS)
                if hit:
                    flags.add("sensitive-keyword", f["index"], [unit["id"]], ", ".join(hit[:4]))
            if len(line) > LONG_LINE and not f["generated_base"]:
                flags.add("long-line", f["index"], [unit["id"]], "%s %d chars" % (ref, len(line)))
            if cls == "ci":
                note = ci_note(line)
                if note:
                    flags.add("ci", f["index"], [unit["id"]], "%s %s" % (ref, note))
    if cls == "test" and assert_removed > assert_added:
        flags.add("assertions-removed", f["index"], [u["id"] for u in units],
                  "%d removed, %d added" % (assert_removed, assert_added))


def ci_note(line):
    s = line.strip()
    if "pull_request_target" in s:
        return "pull_request_target trigger"
    if re.search(r"\bworkflow_run\b", s):
        return "workflow_run trigger"
    if re.search(r"\bpermissions\b", s) or re.search(r":\s*write\b", s):
        return "permissions"
    if "${{" in s and "github.event." in s:
        return "event data in an expression"
    if re.search(r"\bsecrets\.", s):
        return "uses secrets"
    match = re.search(r"\buses:\s*([^\s#]+)", s)
    if match and not match.group(1).startswith("./") and not SHA_PIN_RE.search(match.group(1)) \
            and not match.group(1).startswith("docker://"):
        return "action not pinned to a commit: %s" % clean_line(match.group(1))
    if re.search(r"curl[^|]{0,200}\|\s*(?:ba)?sh|wget[^|]{0,200}\|\s*(?:ba)?sh", s):
        return "pipes a download into a shell"
    return None


def file_flags(f, units, flags, config):
    """Flags that depend on the file as a whole."""
    path, old_path, idx = f["path"], f["old_path"], f["index"]
    all_ids = [u["id"] for u in units]
    shown = path or old_path
    both = [p for p in (path, old_path) if p]
    if f["class"] == "ci" or f.get("old_class") == "ci":
        flags.add("ci", idx, all_ids, None if f["class"] == "ci" else "moved out of CI config: %s" % clean_line(old_path))
    if any(any_glob(LOCAL_EXEC_GLOBS, p) for p in both):
        flags.add("local-exec", idx, all_ids)
    if any(any_glob(REGISTRY_GLOBS, p) for p in both):
        flags.add("registry-config", idx, all_ids)
    if f.get("old_class") == "lockfile" and f["class"] != "lockfile" or (
            f["class"] == "lockfile" and f["status"] in "RC" and f.get("old_class") != "lockfile"):
        flags.add("sensitive-rename", idx, all_ids, "lockfile name changed: %s -> %s" % (
            clean_line(old_path or ""), clean_line(path or "")))
    policy = config["sensitive"]
    if policy and any(any_glob(policy, p) for p in both):
        flags.add("policy-sensitive", idx, all_ids)
    if path and f["status"] != "D" and any_glob(EXEC_HINT_GLOBS, path) and f["class"] not in ("ci",):
        flags.add("sensitive-path", idx, all_ids)
    if any_glob(REVIEW_SURFACE_GLOBS, shown) or (old_path and any_glob(REVIEW_SURFACE_GLOBS, old_path)):
        flags.add("review-surface", idx, all_ids)
    sensitive = SENSITIVE_GLOBS + config["sensitive"]
    if f["status"] in "RC" and path and any_glob(sensitive, path) and not any_glob(sensitive, old_path):
        flags.add("sensitive-rename", idx, all_ids, "%s -> %s" % (clean_line(old_path), clean_line(path)))
    if f["status"] in "RC" and path and os.path.splitext(old_path)[1].lower() not in CODE_EXT \
            and os.path.splitext(path)[1].lower() in CODE_EXT:
        flags.add("sensitive-rename", idx, all_ids, "became code: %s -> %s" % (
            clean_line(old_path), clean_line(path)))
    if f["class"] == "binary" and f["status"] != "D":
        flags.add("binary", idx, all_ids)
    if f.get("old_class") == "test" and (f["status"] == "D" or f["class"] != "test"):
        flags.add("test-deleted", idx, all_ids, None if f["status"] == "D" else "no longer a test path: %s" % clean_line(path))
    elif f["status"] in "R" and TEST_NAME_RE.search(os.path.basename(old_path)) and \
            not TEST_NAME_RE.search(os.path.basename(path)):
        flags.add("test-deleted", idx, all_ids, "no longer named as a test: %s" % clean_line(path))
    old_kind, new_kind = blob_kind(f["old_mode"]), blob_kind(f["new_mode"])
    if f["old_mode"] and f["new_mode"] and old_kind == new_kind == "file" and f["old_mode"] != f["new_mode"]:
        flags.add("exec-bit", idx, all_ids, "%s -> %s" % (f["old_mode"], f["new_mode"]))
    if f["status"] == "A" and f["new_mode"] == "100755":
        flags.add("exec-bit", idx, all_ids, "new executable file")
    if (new_kind == "symlink" and f["status"] != "D") or (old_kind == "symlink" and new_kind not in (None, "symlink")):
        flags.add("symlink", idx, all_ids, f.get("link_target"))
    if MODE_SUBMODULE in (f["old_mode"], f["new_mode"]):
        flags.add("submodule", idx, all_ids, "%s -> %s" % ((f["old_blob"] or "none")[:12], (f["new_blob"] or "none")[:12]))
    if any(unsafe_chars(p) or re.search(r"[\n\t\r]", p) for p in both):
        flags.add("hidden-text", idx, all_ids, "in the file name")
    if any_glob(MIGRATION_GLOBS, shown) and f["class"] not in ("docs", "test"):
        flags.add("migration", idx, all_ids)
    if f["class"] not in ("docs", "lockfile"):
        hit = sorted(words_in(shown) & SENSITIVE_WORDS)
        if hit:
            flags.add("sensitive-keyword", idx, all_ids, "path: " + ", ".join(hit[:4]))
    if f["claims_generated"]:
        flags.add("claims-generated", idx, all_ids)


