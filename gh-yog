# test pairing (heuristic)

def norm_stem(path, test=False):
    base = os.path.basename(path)
    stem = "" if base.startswith(".") else base.split(".")[0]
    if test:
        stem = re.sub(r"^(?:test_|tests_)", "", stem)
        stem = re.sub(r"(?:_test|_tests|_spec|Tests|Test|Spec|IT)$", "", stem)
    return stem.lower()


GENERIC_STEMS = set(["index", "main", "__init__", "mod", "lib", "src", "utils", "util", "app", "types"])


def pair_tests(source_paths, head_tree, changed_paths):
    """For each source path: 'changed', 'unchanged' or 'none', with the test files found."""
    index = {}
    for p in head_tree:
        if is_test_path(p) and os.path.basename(p) != "conftest.py":
            index.setdefault(norm_stem(p, test=True), []).append(p)
    out = {}
    for path in source_paths:
        stem = norm_stem(path)
        found = [p for p in index.get(stem, []) if p != path] if stem not in GENERIC_STEMS else []
        parent = os.path.basename(os.path.dirname(path)).lower()
        if parent and parent not in GENERIC_STEMS:
            found += [p for p in index.get(parent, []) if p != path and p not in found]
        if not found:
            out[path] = {"status": "none", "tests": []}
        elif any(p in changed_paths for p in found):
            out[path] = {"status": "changed", "tests": [p for p in found if p in changed_paths][:3]}
        else:
            out[path] = {"status": "unchanged", "tests": found[:3]}
    return out


