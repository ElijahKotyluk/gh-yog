def is_lockfile(path):
    return os.path.basename(path) in LOCKFILES


def is_manifest(path):
    return os.path.basename(path) in MANIFESTS or any_glob(MANIFEST_GLOBS, path)


def is_test_path(path):
    parts = path.split("/")
    return bool(TEST_DIRS.intersection(parts[:-1])) or bool(TEST_NAME_RE.search(parts[-1]))


CONFIG_EXT = set([".json", ".jsonc", ".json5", ".yml", ".yaml", ".toml", ".ini", ".cfg", ".conf",
                  ".properties", ".env", ".editorconfig", ".plist", ".xml"])
CONFIG_NAME_RE = re.compile(r"(^\.)|(\.config\.[a-z0-9]+$)")


def is_config_path(path):
    base = os.path.basename(path)
    return os.path.splitext(base)[1].lower() in CONFIG_EXT or bool(CONFIG_NAME_RE.search(base))


def is_doc_path(path):
    base = os.path.basename(path)
    stem, ext = os.path.splitext(base)
    ext = ext.lower()
    if ext in CODE_EXT or ext in CONFIG_EXT:
        return False
    if ext in (".md", ".rst", ".adoc"):
        return True
    if stem.upper() in DOC_NAMES and ext in ("", ".txt"):
        return True
    return ext == ".txt" and base not in ("CMakeLists.txt",) and not is_manifest(path)


def classify(path, binary):
    if binary:
        ext = os.path.splitext(path)[1].lower()
        return "asset" if ext in ASSET_EXT else "binary"
    if is_lockfile(path):
        return "lockfile"
    if any_glob(CI_GLOBS, path):
        return "ci"
    if is_manifest(path):
        return "manifest"
    if is_test_path(path):
        return "test"
    if is_doc_path(path):
        return "docs"
    if is_config_path(path):
        return "config"
    return "source"


def has_generated_marker(data):
    if data is None:
        return False
    head = "\n".join(split_lines(data[:4000])[:10])
    return bool(GENERATED_MARKER_RE.search(head)) or "<auto-generated" in head


