CITE_RE = re.compile(r"^(\d+\.\d+(?:\.\d+)?)(?::([+-])(\d+))?$")
FILE_CITE_RE = re.compile(r"^(\d+):([+-])(\d+)$")
PATH_CITE_RE = re.compile(r"^([^\s:]*[/.][^\s:]*):\+(\d+)$")
UNIT_RE = re.compile(r"^\d+\.\d+(?:\.\d+)?$")
GROUP_ID_RE = re.compile(r"^[A-Za-z0-9_-]{1,20}$")
BRIEF_KEYS = set(["schema", "pr", "local", "head", "merge_base", "summary", "claims", "undisclosed",
                  "groups", "not_examined", "questions", "allow_large_group", "todo_units"])
GROUP_KEYS = set(["id", "title", "intent", "units", "risk", "why", "evidence", "tests", "tests_note",
                  "tests_evidence"])
CLAIM_KEYS = set(["text", "status", "evidence", "note"])
LIMITS["note"] = 200


SHA_RE = re.compile(r"^[0-9a-f]{40}(?:[0-9a-f]{24})?$")


def resolve_target(args):
    """What the user asked to check: a PR (from the arguments or the current branch) or a
    local base. The brief must match it; the brief never chooses what gets checked."""
    if getattr(args, "head", None) and not getattr(args, "base", None):
        die("--head needs --base")
    if getattr(args, "base", None):
        if args.pr or args.repo:
            die("give a PR, or --base for local commits, not both")
        base_tip = rev(args.base)
        head = rev(getattr(args, "head", None) or "HEAD")
        if not base_tip or not head:
            die("cannot resolve %s" % (args.base if not base_tip else args.head))
        return {"mode": "local", "base_tip": base_tip, "head": head, "label": args.base}
    host, owner, repo, number = resolve_pr(args.pr, args.repo)
    return {"mode": "pr", "host": host, "owner": owner, "repo": repo, "number": number}


def context_from_brief(brief, target, allow_merged=False):
    """Rebuild the diff context for a brief and check it is current and is for the target.
    Returns (ctx, problems)."""
    head, mb = brief.get("head"), brief.get("merge_base")
    if not isinstance(head, str) or not isinstance(mb, str) or not SHA_RE.match(head) or not SHA_RE.match(mb):
        die("the brief has no valid head or merge_base; run collect again")
    pr = brief.get("pr")
    if target["mode"] == "pr":
        want = (target["owner"].lower(), target["repo"].lower(), target["number"])
        if not isinstance(pr, dict) or brief.get("local") is not None:
            return None, ["this brief is not for %s/%s#%d; run collect for that PR" % (
                target["owner"], target["repo"], target["number"])]
        try:
            got = (str(pr["owner"]).lower(), str(pr["repo"]).lower(), int(pr["number"]))
        except (KeyError, TypeError, ValueError):
            got = None
        if got != want:
            return None, ["this brief is not for %s/%s#%d; run collect for that PR" % (
                target["owner"], target["repo"], target["number"])]
        meta = fetch_pr_meta(target["host"], target["owner"], target["repo"], target["number"])
        if meta["head_oid"] != head:
            return None, ["stale: the PR's head is now %s, the brief is for %s; run collect again" % (
                meta["head_oid"][:12], head[:12])]
        base_tip, live_mb, live_head = prepare_pr(meta, allow_merged)
        if live_mb != mb:
            return None, ["stale: the PR's merge base is now %s, the brief is for %s; run collect again" % (
                live_mb[:12], mb[:12])]
        return {"mode": "pr", "pr": meta, "base_tip": base_tip, "merge_base": mb, "head": live_head}, []
    local = brief.get("local")
    if pr is not None or not isinstance(local, dict) or local.get("base_tip") != target["base_tip"]:
        return None, ["this brief is not for local commits on %s; run collect --base %s" % (
            clean_line(target["label"]), clean_line(target["label"]))]
    base_tip = target["base_tip"]
    if head != target["head"]:
        return None, ["this brief is for head %s, not %s; run collect again or pass --head" % (
            head[:12], target["head"][:12])]
    live_mb = merge_base_local(base_tip, head)
    if live_mb != mb:
        return None, ["the brief's merge base does not match its commits; run collect again"]
    return {"mode": "local", "pr": None, "base_tip": base_tip, "merge_base": mb, "head": head,
            "subjects": local_subjects(mb, head)}, []


C_LIKE = set([".js", ".mjs", ".cjs", ".jsx", ".ts", ".mts", ".cts", ".tsx", ".java", ".kt", ".scala",
              ".c", ".h", ".cc", ".cpp", ".hpp", ".cs", ".go", ".rs", ".swift", ".dart", ".php"])
HASH_LIKE = set([".py", ".rb", ".sh", ".bash", ".zsh", ".pl", ".r", ".ex", ".exs", ".toml", ".yml", ".yaml"])
DASH_LIKE = set([".sql", ".lua", ".hs"])


def comment_only(unit, path=""):
    """True when every changed line of a hunk is a comment or blank, judged by the file's
    language and by block-comment state across the hunk (a heuristic; unknown languages
    never count as comment-only)."""
    ext = os.path.splitext(path)[1].lower()
    if ext not in C_LIKE and ext not in HASH_LIKE and ext not in DASH_LIKE:
        return False
    in_block = in_string = False
    for kind, _, _, line in unit["lines"]:
        t = line.strip()
        comment = not t
        if ext in C_LIKE and t:
            if in_block:
                comment = True
                if "*/" in t:
                    in_block = False
                    comment = not t.split("*/", 1)[1].strip()
            elif t.startswith("//"):
                comment = True
            elif t.startswith("/*"):
                if "*/" in t[2:]:
                    comment = not t[2:].split("*/", 1)[1].strip()
                else:
                    in_block = comment = True
        elif ext in HASH_LIKE and t:
            quotes = t.count('"""') + t.count("\'\'\'")
            comment = t.startswith("#") and not in_string
            if quotes % 2:
                in_string = not in_string
                comment = False
        elif ext in DASH_LIKE and t:
            comment = t.startswith("--")
        if kind in "+-" and not comment:
            return False
    return True


def sentences(s):
    return [p for p in re.split(r"(?<=[.!?])\s+", s.strip()) if p]


class Checker(object):
    def __init__(self, facts, brief):
        self.facts, self.brief, self.problems = facts, brief, []
        self.units = dict((u["id"], u) for u in facts["units"])
        self.files = dict((f["index"], f) for f in facts["files"])
        self.head_tree = None

    def problem(self, msg):
        self.problems.append(msg)

    def string(self, where, value, limit_key, required=True):
        if not isinstance(value, str):
            self.problem("%s must be a string" % where)
            return ""
        if required and not value.strip():
            self.problem("%s is empty" % where)
        limit = LIMITS.get(limit_key)
        if limit and len(value) > limit:
            self.problem("%s is %d characters; the limit is %d" % (where, len(value), limit))
        if "\n" in value or "\t" in value or "\r" in value:
            self.problem("%s must be one line" % where)
        bad = unsafe_chars(value.replace("\n", " ").replace("\t", " "))
        if bad:
            self.problem("%s contains hidden or control characters (%s)" % (where, char_codes(bad)))
        return value

    def citation(self, where, value, allowed_units=None, allowed_files=None):
        """Validate one citation. Returns {"file": index, "unit": unit or None} or None.

        Forms: UNIT:+N / UNIT:-N (a line in or within CITE_SLACK of that unit), F.0 (a whole-file
        unit), and F:+N / F:-N (any line of changed file F at head or base, for context)."""
        if not isinstance(value, str):
            self.problem("%s: citation must be a string" % where)
            return None
        fmatch = FILE_CITE_RE.match(value)
        if fmatch:
            index, side, n = int(fmatch.group(1)), fmatch.group(2), int(fmatch.group(3))
            f = self.files.get(index)
            if f is None:
                self.problem("%s: %d is not a file of this diff" % (where, index))
                return None
            if allowed_files is not None and index not in allowed_files:
                self.problem("%s: file %d is not one of this group's files" % (where, index))
                return None
            count = f.get("head_lines" if side == "+" else "base_lines") or 0
            if n < 1 or n > count:
                self.problem("%s: file %d has no %s line %d" % (where, index, "head" if side == "+" else "base", n))
                return None
            return {"file": index, "unit": None, "kind": "context", "side": side}
        match = CITE_RE.match(value)
        if not match:
            self.problem("%s: %r is not a citation (UNIT:+N, UNIT:-N, F:+N, F:-N, or F.0 for a whole file)"
                         % (where, value))
            return None
        uid, side, number = match.group(1), match.group(2), match.group(3)
        unit = self.units.get(uid)
        if unit is None:
            self.problem("%s: %s is not a unit of this diff" % (where, uid))
            return None
        if allowed_units is not None and uid not in allowed_units:
            self.problem("%s: %s is not one of this group's units (cite context as F:+N)" % (where, uid))
            return None
        if side is None:
            if unit["kind"] != "file":
                self.problem("%s: %s needs a line, as %s:+N or %s:-N" % (where, uid, uid, uid))
                return None
            if any(v["file"] == unit["file"] and v["kind"] == "hunk" for v in self.facts["units"]):
                self.problem("%s: file %d has changed lines; cite one of them instead of %s" % (where, unit["file"], uid))
                return None
            return {"file": unit["file"], "unit": unit, "kind": "unit", "side": None}
        if unit["kind"] == "file":
            self.problem("%s: %s is a whole-file unit; cite it without a line, or as %d:+N" % (where, uid, unit["file"]))
            return None
        span = unit["head"] if side == "+" else unit["base"]
        n = int(number)
        if not span or n < span[0] - CITE_SLACK or n > span[1] + CITE_SLACK:
            self.problem("%s: line %s%d is outside unit %s (%s side %s); cite context as %d:%s%d" % (
                where, side, n, uid, "head" if side == "+" else "base",
                "%d-%d" % tuple(span) if span else "empty", unit["file"], side, n))
            return None
        return {"file": unit["file"], "unit": unit, "kind": "unit", "side": side}

    def test_citation(self, where, value):
        """tests_evidence also accepts PATH:+N for a test file the PR did not change."""
        if isinstance(value, str) and not FILE_CITE_RE.match(value) and not CITE_RE.match(value):
            m = PATH_CITE_RE.match(value)
            if m:
                path, n = m.group(1), int(m.group(2))
                if unsafe_chars(path) or "\0" in path or path.startswith(("/", "-")) or \
                        any(part in ("", ".", "..") for part in path.split("/")):
                    self.problem("%s: %r is not a plain repository path" % (where, clean_line(path)))
                    return None
                if self.head_tree is None:
                    self.head_tree = set(list_tree(self.facts["head"]))
                if path not in self.head_tree:
                    self.problem("%s: %s is not a file at the head commit" % (where, clean_line(path)))
                    return None
                if not is_test_path(path):
                    self.problem("%s: %s is not a test file path" % (where, clean_line(path)))
                    return None
                data = read_path(self.facts["head"], path)
                if data is None or looks_binary(data) or n < 1 or n > len(split_lines(data)):
                    self.problem("%s: %s has no line %d at the head commit" % (where, clean_line(path), n))
                    return None
                return {"file": None, "path": path, "unit": None, "kind": "path", "side": "+"}
        return self.citation(where, value)

    def unit_list(self, where, value):
        if not isinstance(value, list) or not all(isinstance(v, str) for v in value):
            self.problem("%s must be a list of unit ids" % where)
            return []
        out = []
        for uid in value:
            if uid not in self.units:
                self.problem("%s: %s is not a unit of this diff" % (where, uid))
            else:
                out.append(uid)
        return out

    def hard_flags(self, unit_ids):
        codes = set()
        for uid in unit_ids:
            for code in self.units[uid]["flags"]:
                if FLAGS[code][0] == "hard":
                    codes.add(code)
        return codes

    def run(self):
        b = self.brief
        if not isinstance(b, dict):
            self.problem("the brief must be a JSON object")
            return self.problems
        for key in sorted(set(b) - BRIEF_KEYS):
            self.problem("unknown field %r" % key)
        if b.get("schema") != BRIEF_SCHEMA:
            self.problem("schema must be %d" % BRIEF_SCHEMA)
        summary = self.string("summary", b.get("summary"), "summary")
        if summary and len(sentences(summary)) > MAX_SUMMARY_SENTENCES:
            self.problem("summary has %d sentences; the limit is %d" % (len(sentences(summary)), MAX_SUMMARY_SENTENCES))
        self.string("allow_large_group", b.get("allow_large_group", ""), "allow_large_group", required=False)
        todo = b.get("todo_units", [])
        if not isinstance(todo, list) or todo:
            self.problem("todo_units still lists %s; assign each to a group or to not_examined, then empty it"
                         % (", ".join(map(str, todo[:8])) + (" ..." if len(todo) > 8 else "") if isinstance(todo, list) else "?"))
        self.check_claims()
        assigned = {}
        groups = self.check_groups(assigned)
        self.check_not_examined(assigned)
        self.check_coverage(assigned)
        self.check_share(groups)
        self.check_undisclosed()
        questions = b.get("questions", [])
        if not isinstance(questions, list):
            self.problem("questions must be a list")
        else:
            if len(questions) > MAX_QUESTIONS:
                self.problem("%d questions; the limit is %d" % (len(questions), MAX_QUESTIONS))
            for i, q in enumerate(questions, 1):
                self.string("question %d" % i, q, "question")
        return self.problems

    def check_claims(self):
        claims = self.brief.get("claims")
        if not isinstance(claims, dict):
            self.problem("claims must be an object keyed by claim id")
            return
        ids = [c["id"] for c in self.facts["claims"]]
        for cid in ids:
            if cid not in claims:
                self.problem("claim %s is not answered" % cid)
        for cid in sorted(set(claims) - set(ids)):
            self.problem("claim %s is not a claim this PR makes" % cid)
        for cid in ids:
            answer = claims.get(cid)
            if answer is None:
                continue
            if not isinstance(answer, dict):
                self.problem("claim %s must be an object" % cid)
                continue
            for key in sorted(set(answer) - CLAIM_KEYS):
                self.problem("claim %s: unknown field %r" % (cid, key))
            live = clean_line(next(c["text"] for c in self.facts["claims"] if c["id"] == cid))
            if answer.get("text") != live:
                self.problem("claim %s: its text no longer matches the PR (%r); run collect again, or restore "
                             "the text field" % (cid, live[:60]))
            status = answer.get("status")
            if status not in CLAIM_STATUSES:
                self.problem("claim %s: status must be one of %s" % (cid, ", ".join(CLAIM_STATUSES)))
            evidence = answer.get("evidence", [])
            if not isinstance(evidence, list):
                self.problem("claim %s: evidence must be a list" % cid)
                evidence = []
            for e in evidence:
                self.citation("claim %s" % cid, e)
            if status in ("matches", "partial", "contradicted") and not evidence:
                self.problem("claim %s is %s but cites no evidence" % (cid, status))
            elif status in ("matches", "partial", "contradicted") and not any(
                    isinstance(e, str) and CITE_RE.match(e) for e in evidence):
                self.problem("claim %s is %s; cite at least one changed line (a unit citation), not only context"
                             % (cid, status))
            if "note" in answer:
                self.string("claim %s note" % cid, answer["note"], "note", required=False)

    def check_groups(self, assigned):
        groups = self.brief.get("groups")
        if not isinstance(groups, list):
            self.problem("groups must be a list")
            return []
        required = [u for u in self.facts["units"] if u["required"]]
        if required and not groups:
            self.problem("there are units to review but no groups")
        if len(groups) > MAX_GROUPS:
            self.problem("%d groups; the limit is %d" % (len(groups), MAX_GROUPS))
        seen, valid, last_rank = set(), [], None
        for n, g in enumerate(groups, 1):
            where = "group %d" % n
            if not isinstance(g, dict):
                self.problem("%s must be an object" % where)
                continue
            gid = g.get("id")
            if not isinstance(gid, str) or not GROUP_ID_RE.match(gid):
                self.problem("%s: id must be 1 to 20 letters, digits, - or _" % where)
            elif gid in seen:
                self.problem("%s: id %s is used twice" % (where, gid))
            else:
                seen.add(gid)
                where = "group %s" % gid
            for key in sorted(set(g) - GROUP_KEYS):
                self.problem("%s: unknown field %r" % (where, key))
            self.string("%s title" % where, g.get("title"), "title")
            self.string("%s intent" % where, g.get("intent"), "intent")
            self.string("%s why" % where, g.get("why"), "why")
            self.string("%s tests_note" % where, g.get("tests_note", ""), "tests_note", required=False)
            risk = g.get("risk")
            if risk not in RISKS:
                self.problem("%s: risk must be high, medium or low" % where)
                risk = None
            tests = g.get("tests")
            if tests not in TEST_STATUSES:
                self.problem("%s: tests must be one of %s" % (where, ", ".join(TEST_STATUSES)))
            ids = self.unit_list("%s units" % where, g.get("units"))
            if not g.get("units"):
                self.problem("%s has no units" % where)
            for uid in ids:
                assigned.setdefault(uid, []).append(where)
                u = self.units[uid]
                if u["kind"] == "file" and not u["required"] and any(
                        v["file"] == u["file"] and v["kind"] == "hunk" for v in self.facts["units"]):
                    self.problem("%s: %s is a whole-file unit of a file with hunks; list its hunks instead" % (where, uid))
            if risk:
                rank = RISK_RANK[risk]
                if last_rank is not None and rank > last_rank:
                    self.problem("%s is %s but comes after a lower-risk group; order groups high to low" % (where, risk))
                last_rank = rank if last_rank is None else min(last_rank, rank)
            hard = self.hard_flags(ids)
            if hard and risk != "high":
                self.problem("%s holds hard-flagged units (%s) and must be high risk" % (where, ", ".join(sorted(hard))))
            evidence = g.get("evidence", [])
            if not isinstance(evidence, list):
                self.problem("%s: evidence must be a list" % where)
                evidence = []
            group_files = sorted(set(self.units[uid]["file"] for uid in ids))
            cited = [self.citation(where, e, allowed_units=set(ids), allowed_files=set(group_files)) for e in evidence]
            cited_files = set(c["file"] for c in cited if c)
            changed_cited = set(c["file"] for c in cited if c and c["kind"] == "unit")
            if risk in ("high", "medium") and not evidence:
                self.problem("%s is %s risk but cites no evidence" % (where, risk))
            if risk == "high":
                missing = [i for i in group_files if i not in changed_cited]
                if missing:
                    self.problem("%s is high risk; cite at least one changed line (a unit citation) in each of "
                                 "its files (missing: %s)" % (where, ", ".join(self.file_label(i) for i in missing[:5])))
            if risk == "medium" and evidence:
                need = min(3, len(group_files))
                if len(changed_cited) < need:
                    self.problem("%s is medium risk; cite lines in at least %d of its files" % (where, need))
            tests_ev = g.get("tests_evidence", [])
            if not isinstance(tests_ev, list):
                self.problem("%s: tests_evidence must be a list" % where)
                tests_ev = []
            tcited = [self.test_citation("%s tests_evidence" % where, e) for e in tests_ev]
            is_test = lambda c: c["kind"] == "path" or self.files[c["file"]]["class"] == "test"
            for c in tcited:
                if c and (c["side"] != "+" or not is_test(c)):
                    self.problem("%s tests_evidence must cite head lines (+N) of test files" % where)
                    break
            if tests in ("covered", "partial") and not any(c and c["side"] == "+" and is_test(c) for c in tcited):
                self.problem("%s says tests %s; put at least one head line of a test file that exercises it in "
                             "tests_evidence (a test unit, F:+N, or PATH:+N for an unchanged test file)" % (where, tests))
            code_units = [u for u in ids if self.units[u]["kind"] == "hunk"
                          and self.files[self.units[u]["file"]]["class"] == "source"
                          and not comment_only(self.units[u], self.files[self.units[u]["file"]]["path"] or "")]
            if tests == "n/a" and code_units:
                self.problem("%s changes source code, so tests cannot be n/a; use none, partial or covered" % where)
            valid.append((g, ids))
        return valid

    def file_label(self, index):
        f = self.files[index]
        return "%d %s" % (index, clean_line(f["path"] or f["old_path"]))

    def check_not_examined(self, assigned):
        ne = self.brief.get("not_examined", {"units": [], "reason": ""})
        if not isinstance(ne, dict) or set(ne) - set(["units", "reason"]):
            self.problem("not_examined must be {\"units\": [...], \"reason\": \"...\"}")
            return
        ids = self.unit_list("not_examined units", ne.get("units", []))
        for uid in ids:
            assigned.setdefault(uid, []).append("not_examined")
        hard = [uid for uid in ids if self.hard_flags([uid])]
        if hard:
            self.problem("hard-flagged units cannot go to not_examined: %s" % ", ".join(hard[:8]))
        self.string("not_examined reason", ne.get("reason", ""), "reason", required=bool(ids))

    def check_coverage(self, assigned):
        missing = [u["id"] for u in self.facts["units"] if u["required"] and u["id"] not in assigned]
        if missing:
            self.problem("%d unit%s not assigned: %s" % (
                len(missing), "" if len(missing) == 1 else "s",
                ", ".join(missing[:12]) + (" ..." if len(missing) > 12 else "")))
        for uid, places in sorted(assigned.items()):
            if len(places) > 1:
                self.problem("unit %s is assigned more than once (%s)" % (uid, ", ".join(places)))

    def check_share(self, groups):
        t = self.facts["totals"]
        if t["review_lines"] < SHARE_MIN_LINES or t["review_files"] < SHARE_MIN_FILES:
            return
        allow = self.brief.get("allow_large_group")
        if isinstance(allow, str) and allow.strip():
            return
        for g, ids in groups:
            lines = sum(self.units[u].get("lines_counted", self.units[u]["added"] + self.units[u]["removed"])
                        for u in ids if self.units[u]["required"])
            if lines > SHARE_MAX * t["review_lines"]:
                self.problem("group %s holds %d of %d lines to review; split it by concern, or say why it is "
                             "one concern in allow_large_group" % (g.get("id"), lines, t["review_lines"]))

    def check_undisclosed(self):
        items = self.brief.get("undisclosed", [])
        if not isinstance(items, list):
            self.problem("undisclosed must be a list")
            return
        if len(items) > MAX_UNDISCLOSED:
            self.problem("%d undisclosed items; the limit is %d" % (len(items), MAX_UNDISCLOSED))
        for n, item in enumerate(items, 1):
            if not isinstance(item, dict) or set(item) - set(["text", "units"]):
                self.problem("undisclosed %d must be {\"text\": ..., \"units\": [...]}" % n)
                continue
            self.string("undisclosed %d" % n, item.get("text"), "undisclosed")
            if not self.unit_list("undisclosed %d units" % n, item.get("units")):
                self.problem("undisclosed %d names no units" % n)


def check_brief(path, target, allow_merged=False):
    """Recompute the facts for a brief and validate it. Returns (facts, brief, problems)."""
    brief = load_json_file(path, "brief")
    if not isinstance(brief, dict):
        die("brief %s is not a JSON object" % path)
    ctx, problems = context_from_brief(brief, target, allow_merged)
    if problems:
        return None, brief, problems
    facts = compute_facts(ctx)
    return facts, brief, Checker(facts, brief).run()


def print_problems(problems, lead):
    print("%s, %d problem%s:" % (lead, len(problems), "" if len(problems) == 1 else "s"))
    for p in problems:
        print("  - " + clean_line(p))


def target_args(args):
    if getattr(args, "base", None):
        return "--base %s" % shlex.quote(args.base) + (" --head %s" % shlex.quote(args.head) if args.head else "")
    out = []
    if args.pr:
        out.append(shlex.quote(args.pr))
    if args.repo:
        out.append("--repo %s" % shlex.quote(args.repo))
    return " ".join(out)


def cmd_check(args):
    facts, brief, problems = check_brief(args.brief, resolve_target(args), args.allow_merged)
    if problems:
        print_problems(problems, "brief refused")
        return 1
    groups = brief.get("groups") or []
    ne = len((brief.get("not_examined") or {}).get("units") or [])
    print("brief OK: %d group%s, %d unit%s assigned%s" % (
        len(groups), "" if len(groups) == 1 else "s",
        facts["totals"]["required_units"] - ne, "" if facts["totals"]["required_units"] - ne == 1 else "s",
        (", %d not examined" % ne) if ne else ""))
    print("next:  %s render %s %s%s" % (command_name(), shlex.quote(args.brief), target_args(args),
                                         " --allow-merged" if args.allow_merged else ""))
    return 0


# ---------------------------------------------------------------------------
# render
#
# Only the CLI writes section labels. Text written by the agent, and text taken from the
# PR, is printed on lines that start with a fixed prefix, with every hidden character
# escaped; in markdown it is also escaped so it cannot add headings, links, images, HTML
# or mentions.

MD_SPECIAL = re.compile(r"([\\*_\[\]<>!#|~&`:])")
MD_AUTOLINK = re.compile(
    r"[A-Za-z][A-Za-z0-9+.-]*://\S+|www\.\S+|[^\s@]*@[^\s@]*|"
    r"(?:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)?#\d+\b|\bGH-\d+\b|\b[0-9a-fA-F]{7,40}\b")


def md_code(s):
    s = clean_line(s)
    longest = max([len(r) for r in re.findall(r"`+", s)] or [0])
    fence = "`" * (longest + 1)
    pad = " " if longest else ""
    return "%s%s%s%s%s" % (fence, pad, s, pad, fence)


def md_text(s):
    """Escape third-party or agent text for markdown. Every backtick is escaped, so no code
    span can open; URLs, mentions, issue references and commit ids become code spans of
    their own so they neither link, notify nor cross-reference."""
    s = clean_line(s)
    out, pos = [], 0
    esc = lambda t: MD_SPECIAL.sub(r"\\\1", t).replace("$", "<span>$</span>")
    for m in MD_AUTOLINK.finditer(s):
        out.append(esc(s[pos:m.start()]))
        out.append(md_code(m.group(0)))
        pos = m.end()
    out.append(esc(s[pos:]))
    joined = "".join(out)
    joined = re.sub(r"^(\s*)(\d+)([.)])", r"\1\2\\\3", joined)
    return re.sub(r"^(\s*)([-+=])", r"\1\\\2", joined)


class Renderer(object):
    def __init__(self, facts, brief, fmt):
        self.facts, self.brief, self.md = facts, brief, fmt == "md"
        self.units = dict((u["id"], u) for u in facts["units"])
        self.files = dict((f["index"], f) for f in facts["files"])
        self.lines = []
        names = {}
        for f in facts["files"]:
            p = f["path"] or f["old_path"]
            names.setdefault(os.path.basename(p), []).append(p)
        self.short = dict((f["index"], os.path.basename(f["path"] or f["old_path"])
                           if len(names[os.path.basename(f["path"] or f["old_path"])]) == 1
                           else (f["path"] or f["old_path"])) for f in facts["files"])
        self.group_of = {}
        for g in brief.get("groups") or []:
            for uid in g.get("units") or []:
                self.group_of[uid] = g

    def out(self, s=""):
        self.lines.append(s)

    def section(self, title, source):
        if self.md:
            self.out("")
            self.out("### %s _(%s)_" % (title, source))
            self.out("")
        else:
            self.out("")
            self.out("%s [%s]" % (title.upper(), source))

    def ai(self, s, indent="  "):
        """A line of agent- or PR-written text."""
        if self.md:
            self.out("> " + md_text(s))
            self.out("")
        else:
            self.out("%s| %s" % (indent, clean_line(s)))

    def path_of(self, index):
        f = self.files[index]
        return f["path"] or f["old_path"]

    def code(self, s):
        return md_code(s) if self.md else clean_line(s)

    def where(self, uid):
        u = self.units[uid]
        p = self.path_of(u["file"])
        if u["kind"] == "file":
            return p
        if u["head"]:
            return "%s:+%d-%d" % (p, u["head"][0], u["head"][1])
        return "%s:-%d-%d" % (p, u["base"][0], u["base"][1])

    def cite(self, c):
        pmatch = PATH_CITE_RE.match(c) if not FILE_CITE_RE.match(c) and not CITE_RE.match(c) else None
        if pmatch:
            label = clean_line(pmatch.group(1)) + ":+" + pmatch.group(2)
            pr = self.facts.get("pr")
            if self.md and pr:
                base = pr["url"].split("/pull/")[0]
                quoted = "/".join(urllib.parse.quote(part) for part in pmatch.group(1).split("/"))
                url = "%s/blob/%s/%s#L%s" % (base, self.facts["head"], quoted, pmatch.group(2))
                return "[%s](%s)" % (md_text(label), url)
            return md_text(label) if self.md else label
        fmatch = FILE_CITE_RE.match(c)
        if fmatch:
            index, side, n = int(fmatch.group(1)), fmatch.group(2), fmatch.group(3)
        else:
            match = CITE_RE.match(c)
            uid, side, n = match.group(1), match.group(2), match.group(3)
            index = self.units[uid]["file"]
        label = clean_line(self.short[index]) + ((":%s%s" % (side, n)) if side else "")
        pr = self.facts.get("pr")
        if self.md and pr and side:
            f = self.files[index]
            anchor_path = f["path"] if side == "+" else (f["old_path"] or f["path"])
            digest = hashlib.sha256(anchor_path.encode("utf-8", "surrogateescape")).hexdigest()
            url = "%s/files#diff-%s%s%s" % (pr["url"], digest, "R" if side == "+" else "L", n)
            return "[%s](%s)" % (md_text(label), url)
        return md_text(label) if self.md else label

    def bullet(self, s):
        self.out(("- " if self.md else "  - ") + s)

    def render(self):
        f, b = self.facts, self.brief
        t = f["totals"]
        pr = f["pr"]
        if self.md:
            self.out("## yog review brief")
            self.out("")
        else:
            self.out("YOG REVIEW BRIEF")
        if pr:
            title = md_text(pr["title"]) if self.md else clean_line(pr["title"])
            self.out("%s/%s#%d: %s" % (pr["owner"], pr["repo"], pr["number"], title))
            if self.md:
                self.out("")
            self.out("head %s, base %s at %s, merge base %s; checked against the live PR when rendered" % (
                f["head"][:12], clean_line(pr.get("base_ref") or "?"), f["base_tip"][:12], f["merge_base"][:12]))
        else:
            self.out("LOCAL COMMITS, not a PR: base %s, merge base %s, head %s" % (
                f["base_tip"][:12], f["merge_base"][:12], f["head"][:12]))
        if self.md:
            self.out("")
        self.out("%d files, +%d -%d. %d lines in %d files need review; %d files are mechanical." % (
            t["files"], t["added"], t["removed"], t["review_lines"], t["review_files"], t["mechanical_files"]))
        if t["large"]:
            if self.md:
                self.out("")
            self.out("LARGE PR: the groups below are a proposed split.")
        self.out("Sections marked computed come from git. Sections marked AI were written by an agent "
                 "and checked only for coverage, citations and length.")
        self.start_here()
        self.hard_flags()
        self.not_examined()
        self.section("Summary", "AI")
        self.ai(b.get("summary", ""))
        self.claims()
        self.undisclosed()
        self.groups()
        self.mechanical()
        self.dependencies()
        questions = b.get("questions") or []
        if questions:
            self.section("Questions for the author", "AI")
            for q in questions:
                self.ai(q)
        return "\n".join(self.lines).rstrip() + "\n"

    def start_here(self):
        picks = []
        hard_count = lambda u: sum(1 for c in u["flags"] if FLAGS[c][0] == "hard")
        minor = lambda u: 1 if self.files[u["file"]]["class"] in ("test", "docs") else 0
        for g in self.brief.get("groups") or []:
            if g.get("risk") not in ("high", "medium"):
                continue
            cands = [self.units[uid] for uid in g.get("units") or [] if uid in self.units and self.units[uid]["required"]]
            if not cands:
                continue
            cands.sort(key=lambda u: (-hard_count(u), minor(u), -(u["added"] + u["removed"]), u["id"]))
            picks.append((g, cands[0]))
        if not picks:
            return
        self.section("Start here", "computed: the hardest-flagged or largest unit of each high and medium group")
        for n, (g, u) in enumerate(picks[:5], 1):
            hard = [c for c in u["flags"] if FLAGS[c][0] == "hard"]
            flags = (" hard flags: " + ", ".join(hard)) if hard else ""
            self.out(("%d. " if self.md else "  %d. ") % n + "%s %s, group %s (%s)%s" % (
                u["id"], self.code(self.where(u["id"])), clean_line(str(g.get("id"))), g.get("risk"), flags))
        if len(picks) > 5:
            self.out("%d more groups below." % (len(picks) - 5))

    def hard_flags(self):
        hard = [e for e in self.facts["flags"] if e["tier"] == "hard"]
        pr_level = [e for e in self.facts["flags"] if e["file"] is None]
        self.section("Hard flags", "computed")
        if not hard and not pr_level:
            self.out("none" if not self.md else "None.")
            return
        for e in hard + [e for e in pr_level if e["tier"] != "hard"]:
            target = self.code(self.path_of(e["file"])) if e["file"] else "PR text"
            details = ("; " + "; ".join(clean_line(d) for d in e["details"])) if e["details"] else ""
            if self.md:
                details = md_text(details) if details else ""
            self.bullet("%s: %s, %s (units %s)%s" % (
                e["code"], e["title"], target, ", ".join(e["units"][:6]) + (" ..." if len(e["units"]) > 6 else ""),
                details))

    def not_examined(self):
        ne = self.brief.get("not_examined") or {}
        ids = ne.get("units") or []
        if not ids:
            return
        lines = sum(self.units[u]["added"] + self.units[u]["removed"] for u in ids)
        self.section("Not examined", "computed")
        self.out("%d units, %d changed lines, were not read by the agent: %s" % (
            len(ids), lines, ", ".join(ids[:20]) + (" ..." if len(ids) > 20 else "")))
        self.ai("reason: " + ne.get("reason", ""))

    def claims(self):
        claims = self.facts["claims"]
        if not claims:
            return
        answers = self.brief.get("claims") or {}
        order = {"contradicted": 0, "partial": 1, "not_found": 2, "matches": 3, "not_a_claim": 4}
        status = lambda c: (answers.get(c["id"]) or {}).get("status") or "?"
        self.section("Claims in the PR, problems first", "claims from the PR text, answers by AI")
        skipped = [c["id"] for c in claims if status(c) == "not_a_claim"]
        for c in sorted(claims, key=lambda c: (order.get(status(c), 5), int(c["id"][1:]))):
            if status(c) == "not_a_claim":
                continue
            a = answers.get(c["id"]) or {}
            ev = ", ".join(self.cite(e) for e in (a.get("evidence") or []))
            if self.md:
                line = "- **%s %s** %s" % (c["id"], status(c).upper(), md_text(c["text"]))
                self.out(line + ((" (" + ev + ")") if ev else ""))
                if a.get("note"):
                    self.out("  - " + md_text(a["note"]))
            else:
                self.out("  %-4s %-12s %s%s" % (c["id"], status(c).upper(), clean_line(c["text"]),
                                                ("  [" + ev + "]") if ev else ""))
                if a.get("note"):
                    self.out("                    | " + clean_line(a["note"]))
        if skipped:
            self.out(("" if self.md else "  ") + "Judged not to be claims: %s." % ", ".join(skipped))
        if self.facts.get("claims_dropped"):
            self.out("%d more sentences in the PR text were not extracted." % self.facts["claims_dropped"])

    def undisclosed(self):
        items = self.brief.get("undisclosed") or []
        if not items:
            return
        self.section("Changes the PR text does not mention", "AI")
        for item in items:
            self.ai("%s (units %s)" % (item.get("text", ""), ", ".join(item.get("units") or [])))

    def groups(self):
        groups = self.brief.get("groups") or []
        if not groups:
            return
        self.section("Groups, highest risk first", "computed stats, then AI")
        for g in groups:
            ids = g.get("units") or []
            files = sorted(set(self.units[u]["file"] for u in ids))
            added = sum(self.units[u]["added"] for u in ids)
            removed = sum(self.units[u]["removed"] for u in ids)
            hard = sorted(set(c for u in ids for c in self.units[u]["flags"] if FLAGS[c][0] == "hard"))
            hints = sorted(set(c for u in ids for c in self.units[u]["flags"] if FLAGS[c][0] == "hint"))
            unpaired = len([i for i in files if (self.files[i].get("pairing") or {}).get("status") == "none"])
            test_files = len([i for i in files if self.files[i]["class"] == "test"])
            head = "group %s, %s risk" % (clean_line(str(g.get("id"))), clean_line(str(g.get("risk"))).upper())
            if self.md:
                self.out("")
                self.out("#### " + head)
                self.out("")
            else:
                self.out("")
                self.out("  " + head)
            stats = "%d file%s, +%d -%d" % (len(files), "" if len(files) == 1 else "s", added, removed)
            if hard:
                stats += "; hard flags: " + ", ".join(hard)
            if hints:
                stats += "; hints: " + ", ".join(hints)
            if unpaired:
                stats += "; %d source file%s with no test file named after %s" % (
                    unpaired, "" if unpaired == 1 else "s", "it" if unpaired == 1 else "them")
            if test_files:
                stats += "; %d test file%s in this group" % (test_files, "" if test_files == 1 else "s")
            self.out(("computed: " if self.md else "    computed: ") + stats)
            if self.md:
                self.out("")
            names = ", ".join(self.code(self.path_of(i)) for i in files[:8]) + (" ..." if len(files) > 8 else "")
            self.out(("files: " if self.md else "    files: ") + names)
            if self.md:
                self.out("")
            self.ai("title: " + g.get("title", ""), "    ")
            self.ai("intent: " + g.get("intent", ""), "    ")
            self.ai("why: " + g.get("why", ""), "    ")
            ev = g.get("evidence") or []
            if ev:
                self.out(("evidence: " if self.md else "    evidence: ") + ", ".join(self.cite(e) for e in ev))
                if self.md:
                    self.out("")
            tests = "tests: %s" % g.get("tests")
            if g.get("tests_note"):
                tests += ", " + g["tests_note"]
            self.ai(tests, "    ")
            tev = g.get("tests_evidence") or []
            if tev:
                self.out(("tests evidence: " if self.md else "    tests evidence: ") + ", ".join(self.cite(e) for e in tev))
                if self.md:
                    self.out("")
            self.out(("units: " if self.md else "    units: ") + " ".join(ids))

    def mechanical(self):
        mech = [f for f in self.facts["files"] if f["mechanical"]]
        if not mech:
            return
        self.section("Mechanical files, not in any group", "computed")
        for f in mech:
            self.bullet("%s, %s, +%d -%d" % (self.code(f["path"] or f["old_path"]), f["mechanical"], f["added"], f["removed"]))

    def dependencies(self):
        rows = []
        for f in self.facts["files"]:
            for d in f.get("deps") or []:
                rows.append("%s: %s" % (self.code(f["path"] or f["old_path"]), md_text(d) if self.md else d))
            if f.get("lock"):
                l = f["lock"]
                rows.append("%s: %d added, %d removed, %d version changes" % (
                    self.code(f["path"]), l["added"], l["removed"], l["changed"]))
        if not rows:
            return
        self.section("Dependencies", "computed")
        for r in rows[:40]:
            self.bullet(r)
        if len(rows) > 40:
            self.out("%d more" % (len(rows) - 40))


def cmd_render(args):
    facts, brief, problems = check_brief(args.brief, resolve_target(args), args.allow_merged)
    if problems:
        print_problems(problems, "brief refused; fix these, then render")
        return 1
    sys.stdout.write(Renderer(facts, brief, args.format).render())
    return 0


