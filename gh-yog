# claims

CLAIM_STOP = set("a an the to of and or for in on with by from is are be it this that".split())


def claim_words(s):
    """Words for spotting near-duplicate claims: no commit-type prefix, stopwords or plural s."""
    s = re.sub(r"^\w+(?:\([^)]*\))?!?:\s*", "", s.lower())
    out = set()
    for w in re.findall(r"\w+", s):
        if w in CLAIM_STOP:
            continue
        out.add(w[:-1] if len(w) > 3 and w.endswith("s") else w)
    return out


def extract_claims(title, body, subjects):
    """Statements in the PR title, body and commit subjects, each of which the brief answers."""
    found, seen, other_words = [], set(), {}

    def add(source, s):
        s = re.sub(r"\s+", " ", s).strip()
        s = re.sub(r"^(?:[-*+]|\d+[.)])\s+", "", s).strip()
        if len(re.findall(r"\w+", s)) < 3:
            return
        if re.match(r"^\S+://\S+$", s) or s.endswith(":") or s.endswith(":**") or \
                re.match(r"^\*\*[^*]+\*\*:?$", s) or re.match(r"^_[^_]+_$", s):
            return
        key = s.lower().rstrip(".")
        words = claim_words(s)
        for other in seen:
            if other == key or (words and len(words & other_words[other]) >= 0.7 * len(words | other_words[other])):
                return
        seen.add(key)
        other_words[key] = words
        if len(s) > MAX_CLAIM_CHARS:
            s = s[:MAX_CLAIM_CHARS - 3] + "..."
        found.append((source, s))

    if title:
        add("title", title)
    for subject in subjects:
        if subject and not re.match(r"^Merge (?:branch|pull request|remote-tracking)", subject):
            add("commit", subject)
    body = (body or "").replace("\r\n", "\n")
    body = re.sub(r"<!--.*?-->", "", body, flags=re.DOTALL)
    body = re.sub(r"```.*?```", "", body, flags=re.DOTALL)
    body = re.sub(r"!\[[^\]]*\]\([^)]*\)", "", body)
    paragraph = []

    def flush():
        if paragraph:
            for sentence in re.split(r"(?<=[.!?])\s+", " ".join(paragraph)):
                add("body", sentence)
            del paragraph[:]

    for line in body.split("\n"):
        s = line.strip()
        if not s or s.startswith("#") or s.startswith("|") or s.startswith(">"):
            flush()
            continue
        if re.match(r"^[-*+]\s+\[ \]", s):
            flush()
            continue
        if re.match(r"^(?:[-*+]|\d+[.)])\s+", s):
            flush()
            add("body", re.sub(r"^[-*+]\s+\[[xX]\]\s*", "", s))
            continue
        paragraph.append(s)
    flush()
    rank = {"title": 0, "body": 1, "commit": 2}
    found.sort(key=lambda x: rank[x[0]])
    # Keep the title and commit subjects; padding the description cannot push them out.
    fixed = [x for x in found if x[0] != "body"]
    body_items = [x for x in found if x[0] == "body"]
    room = max(0, MAX_CLAIMS - len(fixed))
    kept = set(id(x) for x in fixed[:MAX_CLAIMS] + body_items[:room])
    chosen = [x for x in found if id(x) in kept]
    claims = [{"id": "c%d" % i, "source": src, "text": s} for i, (src, s) in enumerate(chosen, 1)]
    return claims, len(found) - len(chosen)


