# collect

def pr_ref(meta, name):
    return "refs/yog/%s/%s/pr-%d/%s" % (meta["owner"], meta["repo"], meta["number"], name)


def fetch_refs(meta, refspecs, shallow):
    """Fetch from the PR's base repository into refs/yog/..., never touching branches."""
    url = "https://%s/%s/%s.git" % (meta["host"], meta["owner"], meta["repo"])
    gh_path = shutil.which("gh") or "gh"
    args = ["-c", "credential.helper=", "-c", "credential.helper=!%s auth git-credential" % shlex.quote(gh_path),
            "fetch", "--quiet", "--no-tags", "--no-recurse-submodules"]
    if git_version() >= (2, 29):
        args.append("--no-write-fetch-head")
    if shallow:
        args.append("--depth=1")
    git(args + [url] + refspecs)


def has_commit(sha):
    return bool(sha) and git(["cat-file", "-e", sha + "^{commit}"], check=False) is not None


def prepare_pr(meta, allow_merged=False):
    """Fetch the PR's head and base commits and work out its merge base."""
    if meta["state"] != "OPEN" and not allow_merged:
        die("PR %s is %s; yog briefs open PRs (use --allow-merged to brief it anyway)" % (
            meta["number"], meta["state"].lower()))
    if not re.match(r"^[0-9a-f]{40,64}$", meta["head_oid"] or "") or \
            not re.match(r"^[0-9a-f]{40,64}$", meta["base_oid"] or ""):
        die("GitHub did not return the PR's head and base commits")
    shallow = is_shallow()
    head_ref, base_ref = pr_ref(meta, "head"), pr_ref(meta, "base")
    fetch_refs(meta, ["+refs/pull/%d/head:%s" % (meta["number"], head_ref),
                      "+%s:%s" % (meta["base_oid"], base_ref)], shallow)
    head = rev(head_ref)
    if head != meta["head_oid"]:
        die("the PR's head moved while fetching (%s, expected %s); run collect again" % (
            (head or "?")[:12], meta["head_oid"][:12]))
    base_tip = meta["base_oid"]
    mb = None if shallow else merge_base_local(base_tip, head)
    if not mb:
        mb = api_merge_base(meta, base_tip, head)
        if not has_commit(mb):
            fetch_refs(meta, ["+%s:%s" % (mb, pr_ref(meta, "merge-base"))], shallow)
    return base_tip, mb, head


def local_subjects(merge_base, head):
    out = git(["log", "-z", "--format=%s", "%s..%s" % (merge_base, head)])
    return [s for s in text(out).split("\0") if s][::-1]


def work_dir(facts, override=None):
    if override:
        return override
    gdir = git_dir()
    if not gdir:
        die("not in a git repository")
    if facts["mode"] == "pr":
        pr = facts["pr"]
        key = safe_name(pr["owner"], pr["repo"], "pr", pr["number"])
    else:
        key = safe_name("local", facts["head"][:12])
    return os.path.join(gdir, "yog", key)


def brief_template(facts):
    pr = facts["pr"]
    return {
        "schema": BRIEF_SCHEMA,
        "pr": dict((k, pr[k]) for k in ("host", "owner", "repo", "number")) if pr else None,
        "local": None if pr else {"base_tip": facts["base_tip"]},
        "head": facts["head"], "merge_base": facts["merge_base"],
        "summary": "",
        "claims": dict((c["id"], {"text": clean_line(c["text"]), "status": "", "evidence": []}) for c in facts["claims"]),
        "undisclosed": [],
        "groups": [],
        "not_examined": {"units": [], "reason": ""},
        "questions": [],
        "allow_large_group": "",
        "todo_units": [u["id"] for u in facts["units"] if u["required"]],
    }


def refresh_brief(old, fresh):
    """Keep the agent's work in a brief for the same commits, but bring its claims and
    todo list up to date with the live PR text and units."""
    old_claims = old.get("claims") if isinstance(old.get("claims"), dict) else {}
    claims = {}
    for cid, entry in fresh["claims"].items():
        prev = old_claims.get(cid)
        claims[cid] = prev if isinstance(prev, dict) and prev.get("text") == entry["text"] else entry
    old["claims"] = claims
    assigned = set()
    for g in old.get("groups") or []:
        if isinstance(g, dict) and isinstance(g.get("units"), list):
            assigned.update(u for u in g["units"] if isinstance(u, str))
    ne = old.get("not_examined")
    if isinstance(ne, dict) and isinstance(ne.get("units"), list):
        assigned.update(u for u in ne["units"] if isinstance(u, str))
    old["todo_units"] = [u for u in fresh["todo_units"] if u not in assigned]


def write_json(path, data):
    directory = os.path.dirname(path)
    try:
        if directory:
            os.makedirs(directory, exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(data, fh, indent=2, ensure_ascii=True)
            fh.write("\n")
        os.replace(tmp, path)
    except OSError as exc:
        die("cannot write %s: %s" % (path, exc))


def load_json_file(path, what):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (IOError, OSError) as exc:
        die("cannot read %s %s: %s" % (what, path, exc))
    except ValueError as exc:
        die("%s %s is not valid JSON: %s" % (what, path, exc))


def cmd_collect(args):
    if args.base or args.head:
        if args.pr or args.repo:
            die("give a PR, or --base/--head for local commits, not both")
        if not args.base:
            die("--head needs --base")
        base_tip, head = rev(args.base), rev(args.head or "HEAD")
        if not base_tip or not head:
            die("cannot resolve %s" % (args.base if not base_tip else args.head))
        mb = merge_base_local(base_tip, head)
        if not mb:
            die("no merge base between %s and %s" % (args.base, args.head or "HEAD"))
        facts = compute_facts({"mode": "local", "pr": None, "base_tip": base_tip, "merge_base": mb,
                               "head": head, "subjects": local_subjects(mb, head)})
    else:
        host, owner, repo, number = resolve_pr(args.pr, args.repo)
        meta = fetch_pr_meta(host, owner, repo, number)
        base_tip, mb, head = prepare_pr(meta, args.allow_merged)
        facts = compute_facts({"mode": "pr", "pr": meta, "base_tip": base_tip, "merge_base": mb, "head": head})
    directory = work_dir(facts, args.dir)
    facts_path = os.path.join(directory, "facts.json")
    brief_path = os.path.join(directory, "brief.json")
    write_json(facts_path, facts_json(facts))
    kept = False
    if os.path.exists(brief_path):
        try:
            with open(brief_path, encoding="utf-8") as fh:
                old = json.load(fh)
        except (IOError, OSError, ValueError):
            old = None
        fresh = brief_template(facts)
        if isinstance(old, dict) and old.get("head") == facts["head"] and old.get("merge_base") == facts["merge_base"] \
                and old.get("pr") == fresh["pr"] and old.get("local") == fresh["local"]:
            kept = True
            refresh_brief(old, fresh)
            write_json(brief_path, old)
        else:
            old_head = old.get("head") if isinstance(old, dict) and isinstance(old.get("head"), str) else "old"
            stale = os.path.join(directory, "brief-%s.json" % safe_name(old_head[:12]))
            os.replace(brief_path, stale)
            print("moved the brief for an older head to %s" % stale)
    if not kept:
        write_json(brief_path, brief_template(facts))
    print_collect_summary(facts, facts_path, brief_path, kept, (args.base, args.head), args.allow_merged)
    return 0


def print_collect_summary(facts, facts_path, brief_path, kept, local_label=(None, None), allow_merged=False):
    t = facts["totals"]
    name = command_name()
    if facts["pr"]:
        pr = facts["pr"]
        print("%s/%s#%d  %s" % (pr["owner"], pr["repo"], pr["number"], clean_line(pr["title"])))
    print("head %s  merge base %s" % (facts["head"][:12], facts["merge_base"][:12]))
    print("%d files, +%d -%d; %d need review (%d lines, %d units), %d mechanical" % (
        t["files"], t["added"], t["removed"], t["review_files"], t["review_lines"],
        t["required_units"], t["mechanical_files"]))
    hard = [e for e in facts["flags"] if e["tier"] == "hard"]
    hints = [e for e in facts["flags"] if e["tier"] == "hint"]
    print("%d hard flag%s, %d hint%s, %d claim%s" % (
        len(hard), "" if len(hard) == 1 else "s", len(hints), "" if len(hints) == 1 else "s",
        len(facts["claims"]), "" if len(facts["claims"]) == 1 else "s"))
    if t["large"]:
        print("LARGE PR: %d lines need review. Propose a split along the groups." % t["review_lines"])
    for p in facts["config_problems"]:
        print("config: " + p)
    print("facts: %s" % facts_path)
    print("brief: %s%s" % (brief_path, " (kept: same head)" if kept else ""))
    if facts["pr"]:
        pr = facts["pr"]
        target = "%s --repo %s/%s" % (pr["number"], pr["owner"], pr["repo"])
    else:
        target = "--base %s" % shlex.quote(local_label[0]) + (" --head %s" % shlex.quote(local_label[1]) if local_label[1] else "")
    print("read:  %s hunks %s IDS" % (name, shlex.quote(facts_path)))
    if allow_merged:
        target += " --allow-merged"
    print("check: %s check %s %s" % (name, shlex.quote(brief_path), target))


